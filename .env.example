# Private, server-side credential. Obtain your own; never copy the original .env.
DEEPSEEK_API_KEY=
# Defaults preserve the source provider/model. Override with an available model if necessary.
DEEPSEEK_MODEL=deepseek-v4-flash
# Public form identifier, not a private provider credential. Source identifier is preserved by default.
PUBLIC_WEB3FORMS_ACCESS_KEY=ada9f474-2acc-420f-a1df-f88706245294
