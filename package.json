{
  "name": "web-personal-redesign-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node -e \"const fs=require('fs');const f='.vercel/output/functions/_render.func/.vc-config.json';const c=JSON.parse(fs.readFileSync(f,'utf8'));c.runtime='nodejs22.x';fs.writeFileSync(f,JSON.stringify(c,null,2)+'\\n')\"",
    "preview": "astro preview",
    "qc": "node scripts/qc.mjs",
    "astro": "astro",
    "lighthouse:local": "node scripts/lighthouse-local.cjs",
    "lighthouse:prod": "node scripts/lighthouse-prod.cjs",
    "test:api": "node tests/chat-api.test.mjs",
    "test:browser": "playwright test",
    "review:capture": "node scripts/capture-review.mjs",
    "dev:review": "astro dev --host 127.0.0.1 --port 4322 --ignore-lock",
    "test:physics": "node tests/background-physics.test.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@fontsource/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "lighthouse": "^13.4.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "tar": "^7.5.21"
  }
}
