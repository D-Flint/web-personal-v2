---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
export const prerender = true;
---

<BaseLayout
  title="Resume on standby — Hoeurb Vuthi"
  description="My resume is temporarily unavailable. Explore my projects or get in touch in the meantime."
>
  <section class="resume-standby" aria-labelledby="resume-title">
    <h1 id="resume-title">Resume on<br /><em>standby.</em></h1>
    <p>
      My resume is temporarily unavailable. In the meantime, explore my projects or get in touch
      to learn more about my work.
    </p>
    <div class="hero-actions">
      <a class="button" href="/#contact">Get in touch <Arrow /></a>
      <a class="text-link" href="/projects">Explore projects <Arrow /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-standby {
    max-width: 850px;
    padding-block: 110px 140px;
  }
  h1 em {
    color: var(--blue);
  }
  .resume-standby p {
    margin-top: 25px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .resume-standby {
      padding-block: 70px 100px;
    }
  }
</style>
