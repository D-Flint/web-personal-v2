---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectAssembly from '../components/ProjectAssembly.astro';
import { projectPreviews } from '../data/projectPreviews';
import Arrow from '../components/Arrow.astro';
import Contact from '../components/Contact.astro';
import HeroParticles from '../components/HeroParticles.astro';
import { projects } from '../data/projects';
const selectedProjects = ['01', '04', '03'].flatMap(id => projects.filter(project => project.num === id));
---

<BaseLayout>
  <section class="hero hero-particle" aria-labelledby="hero-title">
    <HeroParticles />
    <div class="hero-particle-copy">
      <div>
        <h1 id="hero-title">Software, from<br />the inside <em>out.</em></h1>
      </div>
      <div>
        <p class="hero-intro">
          I’m Hoeurb Vuthi, a developer and MIS student. I build web applications, explore local AI,
          and learn by taking systems apart.
        </p>
        <div class="hero-actions">
          <a class="button" href="#work">Explore my work <Arrow /> </a>
          <a class="text-link" href="#contact">
            Get in touch <Arrow />
          </a>
        </div>
        <p class="hero-note">C++ foundations. Web interfaces. AI experiments.</p>
      </div>
    </div>
  </section>
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="rule-heading">
      <h2 id="work-title">Selected work</h2>
      <p class="small muted">
        A closer look at the systems I’m building, from browser to background process.
      </p>
    </div>{
      selectedProjects.map(project => (
        <ProjectAssembly project={project} preview={projectPreviews[project.num]} />
      ))
    }<div class="archive-link">
      <a class="text-link" href="/projects">Browse all {projects.length} projects <Arrow /> </a>
    </div>
  </section>
  <section id="about" class="section about-section" aria-labelledby="about-title">
    <div>
      <h2 id="about-title">Curiosity is<br />the starting point.</h2>
    </div>
    <div class="about-copy">
      <p>
        I’m a Management Information Systems student at SETEC Institute in Phnom Penh, working
        toward becoming a full-time software developer.
      </p>
      <p>
        I started with C++ and Linux tooling, then found my way to modern web development. Today I
        build with Astro and TypeScript, experiment with local AI and automation, and keep
        sharpening my problem-solving skills.
      </p>
      <p>Straightforward code. Fast interfaces. A little more understanding with every project.</p>
      <a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">
        Read my resume <Arrow />
        <span class="sr-only">(PDF, opens a new tab)</span>
      </a>
      <div class="skills">
        <div>
          <h3>Web & interfaces</h3>
          <p>Astro · TypeScript · HTML · CSS · Tailwind CSS</p>
        </div>
        <div>
          <h3>Systems & tools</h3>
          <p>C++ · Python · Linux · Bash · Git · Docker</p>
        </div>
        <div>
          <h3>AI & automation</h3>
          <p>Local LLMs · Ollama · API integration · Task workflows</p>
        </div>
        <div>
          <h3>Visual practice</h3>
          <p>Photoshop · Illustrator · Lightroom · Layout design</p>
        </div>
      </div>
    </div>
  </section>
  <Contact />
</BaseLayout>
