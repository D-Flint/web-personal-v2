---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout title="Page not found — Hoeurb Vuthi">
  <section class="not-found">
    <h1>A page outside<br />the journal.</h1>
    <p>
      Error 404. This address doesn’t point to a page. Follow the project index, or return to the
      beginning.
    </p>
    <div class="hero-actions">
      <a class="button" href="/">Back to home</a>
      <a class="text-link" href="/projects"> Browse projects </a>
    </div>
  </section>
</BaseLayout>
