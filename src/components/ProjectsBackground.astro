---
// ──────────────────────────────────────────────────────────────────────────────
//  ProjectsBackground.astro — Scenic Grand Narukami Background for Projects Page
// ──────────────────────────────────────────────────────────────────────────────
//  Renders the project list scenic background and smoothly cross-fades into the
//  footer scenic background as the user scrolls to the footer.
// ──────────────────────────────────────────────────────────────────────────────
import { Image } from 'astro:assets';
import ScenicImage from './ScenicImage.astro';
import contactBg from '../assets/images/contact-bg.png';
import contactBgMobile from '../assets/images/contact-bg-9x16.png';
import footerBg from '../assets/images/footer-bg.png';
---

<div
  id="projects-bg-crossfader"
  class="fixed inset-0 pointer-events-none -z-30 overflow-hidden select-none bg-[#0c0b16]"
  aria-hidden="true"
>
  <!-- Global base dark ambient atmosphere -->
  <div class="absolute inset-0 bg-[#0c0b16] -z-10"></div>

  <!-- Layer 1: Projects List Scenic Background -->
  <div
    id="bg-layer-projects"
    class="absolute inset-0 opacity-100 transition-opacity duration-700 ease-out will-change-[opacity]"
  >
    <ScenicImage
      desktop={contactBg}
      mobile={contactBgMobile}
      mobileWidths={[390, 540, 768, 1080]}
      quality={75}
      loading="eager"
      critical
    />
    <div class="absolute top-0 inset-x-0 h-40 bg-gradient-to-b from-pink-900/20 via-purple-950/10 to-transparent"></div>
  </div>

  <!-- Layer 2: Footer Scenic Background -->
  <div
    id="bg-layer-footer"
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-[opacity]"
  >
    <Image
      src={footerBg}
      alt=""
      widths={[480, 768, 1200, 1600, 2048]}
      sizes="100vw"
      format="webp"
      quality={75}
      class="h-full w-full object-cover object-[75%_center] md:object-center select-none pointer-events-none"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/20"></div>
  </div>
</div>

<style>
  @media (max-width: 767px), (pointer: coarse) {
    #projects-bg-crossfader {
      inset: 0 auto auto 0;
      width: 100%;
      height: 100vh;
      height: 100lvh;
    }
  }
</style>

<script>
  (() => {
    function initProjectsCrossfader() {
      const root = document.getElementById('projects-bg-crossfader');
      if (!root || root.dataset.crossfaderReady === 'true') return;
      root.dataset.crossfaderReady = 'true';

      const projectLayer = document.getElementById('bg-layer-projects');
      const footerLayer = document.getElementById('bg-layer-footer');
      const footerEl = document.querySelector('footer');
      if (!projectLayer || !footerLayer || !footerEl) return;

      const mobileQuery = window.matchMedia('(max-width: 767px), (pointer: coarse)');
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      let isFooterActive = false;
      let ticking = false;
      let observer: IntersectionObserver | null = null;

      function setFooterActive(active: boolean) {
        if (isFooterActive === active) return;
        isFooterActive = active;
        if (active) {
          projectLayer.style.opacity = '0';
          footerLayer.style.opacity = '1';
        } else {
          projectLayer.style.opacity = '1';
          footerLayer.style.opacity = '0';
        }
      }

      function prepareMobileLayers() {
        [projectLayer, footerLayer].forEach((layer) => {
          layer.style.display = 'block';
          layer.style.transition = 'none';
          layer.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
            image.loading = 'eager';
            image.decode().catch(() => undefined);
          });
        });
      }

      function smoothstep(value: number) {
        const clamped = Math.min(1, Math.max(0, value));
        return clamped * clamped * (3 - 2 * clamped);
      }

      function evaluateMobileBlend() {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const stageHeight = root.getBoundingClientRect().height || viewportHeight;
        const footerTop = footerEl.getBoundingClientRect().top;
        const start = stageHeight * 0.9;
        const end = stageHeight * 0.3;
        let progress = smoothstep((start - footerTop) / (start - end));
        if (reducedMotionQuery.matches) progress = progress < 0.5 ? 0 : 1;

        projectLayer.style.opacity = (1 - progress).toFixed(4);
        footerLayer.style.opacity = progress.toFixed(4);
        ticking = false;
      }

      function onScroll() {
        if (!mobileQuery.matches || ticking) return;
        ticking = true;
        window.requestAnimationFrame(evaluateMobileBlend);
      }

      function enableDesktopObserver() {
        projectLayer.style.removeProperty('transition');
        footerLayer.style.removeProperty('transition');
        const footerVisible = footerEl.getBoundingClientRect().top < window.innerHeight;
        isFooterActive = !footerVisible;
        setFooterActive(footerVisible);
        observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => setFooterActive(entry.isIntersecting));
          },
          {
            root: null,
            rootMargin: '0px 0px -40px 0px',
            threshold: [0, 0.05, 0.2]
          }
        );
        observer.observe(footerEl);
      }

      function syncMotionMode() {
        observer?.disconnect();
        observer = null;

        if (mobileQuery.matches) {
          prepareMobileLayers();
          onScroll();
        } else {
          enableDesktopObserver();
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      mobileQuery.addEventListener('change', syncMotionMode);
      reducedMotionQuery.addEventListener('change', onScroll);

      document.addEventListener('astro:before-swap', () => {
        observer?.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        mobileQuery.removeEventListener('change', syncMotionMode);
        reducedMotionQuery.removeEventListener('change', onScroll);
      }, { once: true });

      syncMotionMode();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectsCrossfader);
    } else {
      initProjectsCrossfader();
    }
    document.addEventListener('astro:page-load', initProjectsCrossfader);
  })();
</script>
