<!--
  ──────────────────────────────────────────────────────────────────────────────
  SakuraCanvas.astro — Falling Sakura Petals Canvas Animation
  ──────────────────────────────────────────────────────────────────────────────
  Renders a full-viewport <canvas> overlay (pointer-events: none, z-index: -1)
  that draws a continuous stream of falling sakura petals. Each petal has
  randomized size, speed, drift, rotation, and opacity. The simulation starts
  automatically when localStorage("sakura") is "on", and responds to the
  custom "sakura-toggle" event emitted by Navbar.astro.
  ──────────────────────────────────────────────────────────────────────────────
-->
<canvas id="sakura-canvas" class="fixed inset-0 pointer-events-none" style="z-index: 10; width: 100vw; height: 100vh;"></canvas>

<script>
  /**
   * SakuraSimulation — Canvas-based falling sakura petal animation.
   * Each petal is a lightweight object with randomized size, speed, drift,
   * rotation, and opacity. The simulation loops via requestAnimationFrame.
   * Responds to the custom "sakura-toggle" event to start/stop.
   */
  class SakuraSimulation {
    /** @param {HTMLCanvasElement} canvas */
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d");
      this.width = 0;
      this.height = 0;
      this.dpr = 1;
      this.petals = [];
      this.running = false;
      this.scrollPaused = false;
      this.frameId = null;
      this.lastTime = 0;
      this.resize();
      window.addEventListener("resize", () => this.resize());
      
      let scrollTimer = null;
      window.addEventListener("scroll", () => {
        if (!this.running) return;
        this.scrollPaused = true;
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          this.scrollPaused = false;
          this.lastTime = performance.now();
        }, 120);
      }, { passive: true });

      document.addEventListener("sakura-toggle", (e) => {
        e.detail.active ? this.start() : this.stop();
      });
      document.addEventListener("sakura-density-change", () => {
        if (this.running && localStorage.getItem("sakura") === "on") {
          this.stop();
          this.start();
        }
      });

      if (localStorage.getItem("sakura") === "on") this.start();
      // Pause animation when tab is hidden to save CPU/GPU
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          this.stop();
        } else if (localStorage.getItem("sakura") === "on") {
          this.start();
        }
      });
    }

    resize() {
      // Keep simulation coordinates in CSS pixels. The backing store may use a
      // different size, but petal geometry and bounds must match the viewport.
      const width = Math.max(1, Math.round(window.innerWidth));
      const height = Math.max(1, Math.round(window.innerHeight));
      const dpr = Math.min(window.devicePixelRatio || 1, 1);
      this.width = width;
      this.height = height;
      this.canvas.width = Math.round(width * dpr);
      this.canvas.height = Math.round(height * dpr);
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      this.dpr = dpr;
      this.ctx.clearRect(0, 0, width, height);
    }

    /** Returns petal count based on viewport size and density preference */
    getPetalCount() {
      const isMobile = this.width < 768;
      const density = localStorage.getItem("sakura-density") || "low";
      const map = isMobile
        ? { low: 6, medium: 12, high: 20 }
        : { low: 10, medium: 20, high: 35 };
      return map[density] || (isMobile ? 6 : 10);
    }

    start() {
      if (this.running) return;
      this.running = true;
      const petalCount = this.getPetalCount();
      this.petals = Array.from({ length: petalCount }, () => this.createPetal(true));
      this.lastTime = performance.now();
      this.loop(this.lastTime);
    }

    stop() {
      this.running = false;
      if (this.frameId) { cancelAnimationFrame(this.frameId); this.frameId = null; }
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    }

    createPetal(randomY) {
      const w = this.width;
      const h = this.height;
      return {
        x: Math.random() * w,
        y: randomY ? Math.random() * h : -20 - Math.random() * 60,
        size: 6 + Math.random() * 8,
        speedY: 0.4 + Math.random() * 0.6,
        speedX: 0.2 + Math.random() * 0.4,
        windDrift: -0.3 + Math.random() * 0.6,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.03,
        opacity: 0.3 + Math.random() * 0.4,
        petalType: Math.floor(Math.random() * 3),
      };
    }

    drawPetal(p) {
      const ctx = this.ctx;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity;

      const colors = [
        "rgba(251, 207, 232, 0.6)",
        "rgba(244, 114, 182, 0.4)",
        "rgba(249, 168, 212, 0.5)",
      ];
      ctx.fillStyle = colors[p.petalType];

      const s = p.size;
      ctx.beginPath();
      // Sakura petal shape: teardrop with cleft top
      ctx.moveTo(0, -s);
      ctx.bezierCurveTo(s, -s * 0.6, s * 0.8, s * 0.3, 0, s);
      ctx.bezierCurveTo(-s * 0.8, s * 0.3, -s, -s * 0.6, 0, -s);
      ctx.fill();

      ctx.restore();
    }

    update(delta) {
      const w = this.width;
      const h = this.height;
      for (const p of this.petals) {
        p.y += p.speedY * delta * 0.06;
        p.x += (p.speedX * Math.sin(p.y * 0.01 + p.rotation)) + p.windDrift * delta * 0.03;
        p.rotation += p.rotSpeed * delta * 0.06;
        if (p.y > h + 40 || p.x < -60 || p.x > w + 60) {
          Object.assign(p, this.createPetal(false));
        }
      }
    }

    draw() {
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      this.ctx.clearRect(0, 0, this.width, this.height);
      for (const p of this.petals) this.drawPetal(p);
    }

    loop = (time) => {
      if (!this.running) return;
      if (this.scrollPaused) {
        this.frameId = requestAnimationFrame(this.loop);
        return;
      }
      // Throttle to ~30 fps: smooth enough for drifting petals, half the draw cost.
      if (time - this.lastTime < 33) {
        this.frameId = requestAnimationFrame(this.loop);
        return;
      }
      const delta = Math.min(time - this.lastTime, 50);
      this.lastTime = time;
      this.update(delta);
      this.draw();
      this.frameId = requestAnimationFrame(this.loop);
    };
  }

  function initSakura() {
    const canvas = document.getElementById("sakura-canvas");
    if (!canvas) return;

    // Respect reduced motion OS accessibility preference.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) {
      canvas.style.display = "none";
      return;
    }

    // Default mobile users to low density (10 petals) for optimal performance.
    const isMobile = window.matchMedia("(max-width: 768px)").matches || window.matchMedia("(pointer: coarse)").matches;
    if (isMobile && !localStorage.getItem("sakura-density")) {
      localStorage.setItem("sakura-density", "low");
    }

    new SakuraSimulation(canvas);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSakura);
  } else {
    initSakura();
  }
</script>
