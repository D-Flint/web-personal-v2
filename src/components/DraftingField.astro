<div class="drafting-field" aria-hidden="true" data-background="particles-workbench"><canvas id="drafting-canvas"></canvas></div>
<script>
import { stepDesk, clampToViewport, clearanceOpacity, easeOpacity, applyPointerImpulse, applyScrollImpulse, scatterParticle, stepParticle } from '../utils/backgroundPhysics.mjs';
// A reactive particle field and a small physical workbench share the paper.
// Reading clearance affects opacity only; input is local and physics stays in viewport space.
const canvas = document.querySelector<HTMLCanvasElement>('#drafting-canvas')!;
const context = canvas.getContext('2d');
if (context) {
  const ctx = context;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  type Body = { x:number; y:number; vx:number; vy:number; angle:number; spin:number; radius:number; kind:string; opacity:number; depth:number; scrollWeight:number; scrollSway:number; scrollSpin:number };
  type Rect = { x:number; y:number; width:number; height:number };
  let width=0, height=0, frame=0, last=0, geometryDirty=true, viewportDirty=true, ambientTime=0;
  let bodies:Body[]=[], obstacles:Rect[]=[];
  type Particle={x:number;y:number;hx:number;hy:number;vx:number;vy:number;opacity:number};
  let particles:Particle[]=[];
  let accumulator=0;
  let fieldPointer={x:-1000,y:-1000,active:false};
  let held:Body|undefined;
  let pointer={x:0,y:0,time:0};
  let grip={x:0,y:0};
  let heldPointer:number|undefined;
  let paintTime=performance.now();
  let lastScrollY=window.scrollY,lastScrollTime=performance.now(),scrollProgress=Math.max(0,Math.min(1,window.scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)));
  const linkOpacity=new Map<string,number>();
  const palette={paper:'',blue:'',ink:'',side:'',ground:'',line:'',wood:'',highlight:'',shadow:''};
  function updatePalette(){
    const css=getComputedStyle(document.documentElement);
    const read=(name:string)=>css.getPropertyValue(name).trim();
    Object.assign(palette,{paper:read('--white'),blue:read('--technical'),ink:read('--muted'),side:read('--piece-side'),ground:read('--paper'),line:read('--line'),wood:read('--wood'),highlight:read('--pencil-highlight'),shadow:read('--shadow')});
  }
  updatePalette();
  document.addEventListener('theme-change',()=>{updatePalette();draw(0);});

  function allowed(){return !document.hidden&&!reduced.matches;}
  function cacheObstacles(){
    obstacles=[];
    const add=(rect:DOMRect)=>{
      if(rect.width&&rect.height&&rect.bottom>0&&rect.top<height)
        obstacles.push({x:rect.left-5,y:rect.top-5,width:rect.width+10,height:rect.height+10});
    };
    document.querySelectorAll<HTMLElement>('.header, .hero-pixel-field, .motion-heading, .figure, main button, main a, main input, main textarea, main summary, main .tags, .form-actions, .assistant-launcher, dialog[open]').forEach(el=>add(el.getBoundingClientRect()));
    document.querySelectorAll<HTMLElement>('main h1, main h2, main h3, main p, .footer').forEach(el=>{
      const range=document.createRange();range.selectNodeContents(el);
      Array.from(range.getClientRects()).forEach(add);
    });
  }
  function overlap(body:Body, rect:Rect){
    const x=Math.max(rect.x,Math.min(body.x,rect.x+rect.width));
    const y=Math.max(rect.y,Math.min(body.y,rect.y+rect.height));
    return Math.hypot(body.x-x,body.y-y)<body.radius+2;
  }
  function place(){
    const mobile=width<700;
    const kinds=mobile?['key','washer','clip','pencil']:['key','washer','clip','pencil','brace','washer','clip','key'];
    const placed:Body[]=[];
    bodies=kinds.map((kind,i)=>{
      const radius=mobile?(kind==='pencil'?16:12):(kind==='pencil'?30:22);
      const body:Body={kind,radius,x:0,y:0,vx:0,vy:0,angle:(i%3-1)*.32,spin:0,opacity:1,depth:(Math.random()-.5)*10,scrollWeight:.7+Math.random()*.6,scrollSway:(Math.random()-.5)*.22,scrollSpin:(Math.random()-.5)*.018};
      // Sample open paper independently on each visit; maximize clearance if the page is crowded.
      let bestX=width/2,bestY=height/2,bestClearance=-Infinity;
      for(let attempt=0;attempt<240;attempt++){
        body.x=radius+8+Math.random()*Math.max(1,width-radius*2-16);
        body.y=radius+8+Math.random()*Math.max(1,height-radius*2-16);
        let clearance=Infinity;
        for(const rect of obstacles){
          const x=Math.max(rect.x,Math.min(body.x,rect.x+rect.width)),y=Math.max(rect.y,Math.min(body.y,rect.y+rect.height));
          clearance=Math.min(clearance,Math.hypot(body.x-x,body.y-y)-radius);
        }
        for(const other of placed)clearance=Math.min(clearance,Math.hypot(body.x-other.x,body.y-other.y)-radius-other.radius-8);
        if(clearance>bestClearance){bestX=body.x;bestY=body.y;bestClearance=clearance;}
        if(clearance>=18)break;
      }
      body.x=bestX;body.y=bestY;
      clampToViewport(body,width,height);placed.push(body);return body;
    });
    canvas.dataset.objects=String(bodies.length);
  }
  function roundRect(x:number,y:number,w:number,h:number,r:number){ctx.beginPath();ctx.roundRect(x,y,w,h,r);}
  function drawBody(body:Body){
    const size=body.radius/(body.kind==='pencil'||body.kind==='clip'?28:22);
    ctx.save();ctx.globalAlpha=body.opacity;ctx.translate(body.x,visualY(body));ctx.rotate(body.angle);ctx.scale(size,size);
    ctx.lineWidth=1.15;ctx.strokeStyle=palette.blue;ctx.fillStyle=palette.paper;
    ctx.shadowColor=palette.shadow;ctx.shadowBlur=5;ctx.shadowOffsetY=3;
    if(body.kind==='key'||body.kind==='brace'){
      roundRect(-18,-18,36,36,5);ctx.fill();ctx.shadowColor='transparent';ctx.stroke();
      ctx.fillStyle=palette.side;roundRect(-14,-12,28,27,3);ctx.fill();
      ctx.fillStyle=palette.paper;roundRect(-14,-15,28,26,3);ctx.fill();ctx.stroke();
      ctx.fillStyle=palette.blue;ctx.font='14px Inter, sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(body.kind==='brace'?'{}':'esc',0,-1);
    }else if(body.kind==='washer'){
      ctx.beginPath();for(let i=0;i<6;i++){const angle=i*Math.PI/3;const x=Math.cos(angle)*19,y=Math.sin(angle)*19;i?ctx.lineTo(x,y):ctx.moveTo(x,y);}ctx.closePath();ctx.fill();ctx.shadowColor='transparent';ctx.stroke();
      ctx.beginPath();ctx.arc(0,0,9,0,Math.PI*2);ctx.fillStyle=palette.ground;ctx.fill();ctx.stroke();
      ctx.beginPath();ctx.arc(0,0,12,0,Math.PI*2);ctx.strokeStyle=palette.line;ctx.stroke();
    }else if(body.kind==='clip'){
      ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(3,-12);ctx.lineTo(3,10);ctx.bezierCurveTo(3,18,-9,18,-9,10);ctx.lineTo(-9,-12);ctx.bezierCurveTo(-9,-23,10,-23,10,-12);ctx.lineTo(10,12);ctx.bezierCurveTo(10,27,-16,27,-16,12);ctx.lineTo(-16,-8);ctx.stroke();
    }else{
      ctx.fillStyle=palette.blue;roundRect(-22,-4,39,8,1);ctx.fill();ctx.shadowColor='transparent';
      ctx.fillStyle=palette.wood;ctx.beginPath();ctx.moveTo(17,-4);ctx.lineTo(26,0);ctx.lineTo(17,4);ctx.closePath();ctx.fill();
      ctx.fillStyle=palette.ink;ctx.beginPath();ctx.moveTo(23,-1.5);ctx.lineTo(26,0);ctx.lineTo(23,1.5);ctx.closePath();ctx.fill();
      ctx.strokeStyle=palette.highlight;ctx.beginPath();ctx.moveTo(-20,-1);ctx.lineTo(15,-1);ctx.stroke();
      ctx.fillStyle=palette.side;ctx.fillRect(-26,-4,5,8);
    }
    ctx.restore();
  }
  function fade(el:{opacity:number}, target:number, elapsed:number){
    el.opacity=reduced.matches?target:easeOpacity(el.opacity,target,elapsed);
    return el.opacity!==target;
  }
  function draw(elapsed=16.67){
    ctx.clearRect(0,0,width,height);
    let fading=false;
    for(const body of bodies)fading=fade(body,clearanceOpacity({x:body.x,y:visualY(body)},obstacles,body.radius*1.25+5),elapsed)||fading;
    for(const p of particles)fading=fade(p,clearanceOpacity(p,obstacles,7),elapsed)||fading;
    const liveLinks=new Set<string>();
    for(let i=0;i<particles.length;i++){
      const p=particles[i];const near=fieldPointer.active&&Math.hypot(p.x-fieldPointer.x,p.y-fieldPointer.y)<155;
      ctx.globalAlpha=p.opacity;
      ctx.globalAlpha=p.opacity*(near?.65:.27);ctx.fillStyle=palette.blue;ctx.beginPath();ctx.arc(p.x,p.y,near?2:1.3,0,Math.PI*2);ctx.fill();
      if(!near)continue;
      let links=0;
      for(let j=i+1;j<particles.length&&links<3;j++){
        const q=particles[j],distance=Math.hypot(p.x-q.x,p.y-q.y);
        if(distance>=100)continue;
        // Fade the whole trace if any part crosses protected content.
        let target=Math.min(p.opacity,q.opacity);
        const samples=Math.max(1,Math.ceil(distance/8));
        for(let k=0;k<=samples;k++)target=Math.min(target,clearanceOpacity({x:p.x+(q.x-p.x)*k/samples,y:p.y+(q.y-p.y)*k/samples},obstacles,7));
        const key=`${i}:${j}`,previous=linkOpacity.get(key)??0;
        const alpha=reduced.matches?target:easeOpacity(previous,target,elapsed);
        linkOpacity.set(key,alpha);liveLinks.add(key);fading=alpha!==target||fading;
        ctx.globalAlpha=alpha*.16*(1-distance/100);ctx.strokeStyle=palette.blue;ctx.lineWidth=.7;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke();links++;
      }
    }
    for(const key of linkOpacity.keys())if(!liveLinks.has(key))linkOpacity.delete(key);
    ctx.globalAlpha=1;bodies.forEach(drawBody);
    return fading;
  }
  function simulate(){
    // Persistent gentle currents vary by piece; hidden time never advances them.
    ambientTime+=1/60;
    for(const [index,body] of bodies.entries()){
      if(body===held)continue;
      const phase=body.scrollWeight*10+index;
      body.x+=Math.cos(ambientTime*.27+phase)*.15;
      body.y+=Math.sin(ambientTime*.23+phase)*.15;
      body.angle+=Math.sin(ambientTime*.19+phase)*.0005;
    }
    let moving=stepDesk(bodies,{width,height,held,dt:1});
    for(const p of particles)moving=stepParticle(p)||moving;
    return moving;
  }
  function refreshGeometry(){
    if(viewportDirty){resize();viewportDirty=false;}
    if(geometryDirty){cacheObstacles();geometryDirty=false;}
  }
  function tick(time:number){
    frame=0;refreshGeometry();
    const elapsed=Math.min(50,time-paintTime);paintTime=time;
    if(!allowed()){draw(elapsed);canvas.dataset.animating='false';return;}
    accumulator+=Math.min(50,time-last);last=time;
    while(accumulator>=16.67){simulate();accumulator-=16.67;}
    draw(elapsed);
    // Ambient floating continues even after interaction impulses settle.
    frame=requestAnimationFrame(tick);
    canvas.dataset.animating=String(!!frame);
  }
  function wake(){
    canvas.dataset.running=String(allowed());
    if(!allowed()){
      cancelAnimationFrame(frame);frame=0;release();fieldPointer.active=false;canvas.dataset.animating='false';
      if(reduced.matches&&!document.hidden){refreshGeometry();draw();}
      return;
    }
    if(!frame){last=performance.now();paintTime=last;accumulator=0;frame=requestAnimationFrame(tick);canvas.dataset.animating=String(allowed());}
  }
  function invalidate(viewport=false){geometryDirty=true;viewportDirty=viewportDirty||viewport;wake();}
  function visualY(body:Body){return reduced.matches?body.y:Math.max(body.radius,Math.min(height-body.radius,body.y+body.depth*scrollProgress));}

  function placeParticles(){
    const count=width<700?36:80;
    const spacing=.45*Math.sqrt(width*height/count);
    // Mulberry32: a fixed seed makes reloads reproducible, with separate X/Y samples.
    let seed=0x484f4555;
    function random(){
      let value=seed=(seed+0x6d2b79f5)>>>0;
      value=Math.imul(value^(value>>>15),value|1);
      value^=value+Math.imul(value^(value>>>7),value|61);
      return ((value^(value>>>14))>>>0)/4294967296;
    }
    const placed:Particle[]=[];
    for(let i=0;i<count;i++){
      let best={x:0,y:0},bestClearance=-1;
      for(let attempt=0;attempt<64;attempt++){
        const candidate={x:random()*width,y:random()*height};
        let clearance=Infinity;
        for(const other of placed)clearance=Math.min(clearance,Math.hypot(candidate.x-other.x,candidate.y-other.y));
        if(clearance>bestClearance){best=candidate;bestClearance=clearance;}
        if(clearance>=spacing)break;
      }
      const {x,y}=best;
      placed.push({x,y,hx:x,hy:y,vx:0,vy:0,opacity:1});
    }
    return placed;
  }
  function hit(x:number,y:number){return [...bodies].reverse().find(body=>body.opacity>.15&&Math.hypot(body.x-x,visualY(body)-y)<body.radius+5);}
  function interactive(target:EventTarget|null){return target instanceof Element&&!!target.closest('a,button,input,textarea,select,summary,dialog,figure,nav');}
  function release(){
    if(heldPointer!==undefined&&document.body.hasPointerCapture(heldPointer))document.body.releasePointerCapture(heldPointer);
    heldPointer=undefined;held=undefined;delete document.body.dataset.deskDragging;delete document.body.dataset.deskHover;canvas.dataset.interaction='idle';
  }
  document.addEventListener('pointerdown',event=>{
    if(!allowed()||held||interactive(event.target)||event.button!==0)return;
    particles.forEach(p=>scatterParticle(p,event.clientX,event.clientY,230,7));wake();
    const body=hit(event.clientX,event.clientY);if(!body)return;
    if(event.pointerType==='touch'){body.vx+=(event.clientX<width/2?1:-1)*3;body.vy-=2;body.spin+=.12;wake();return;}
    held=body;heldPointer=event.pointerId;document.body.setPointerCapture(event.pointerId);
    grip={x:event.clientX-body.x,y:event.clientY-visualY(body)};pointer={x:event.clientX,y:event.clientY,time:performance.now()};
    body.vx=body.vy=0;document.body.dataset.deskDragging='true';canvas.dataset.interaction='dragging';event.preventDefault();wake();
  });
  document.addEventListener('pointermove',event=>{
    if(!allowed()||event.pointerType==='touch'||heldPointer!==undefined&&heldPointer!==event.pointerId)return;
    const now=performance.now(),dx=held||fieldPointer.active?event.clientX-pointer.x:0,dy=held||fieldPointer.active?event.clientY-pointer.y:0;
    fieldPointer={x:event.clientX,y:event.clientY,active:true};
    if(held){
      held.x=event.clientX-grip.x;held.y=event.clientY-grip.y-held.depth*scrollProgress;clampToViewport(held,width,height);
      const dt=Math.max(1,(now-pointer.time)/16.67);held.vx=Math.max(-14,Math.min(14,dx/dt));held.vy=Math.max(-14,Math.min(14,dy/dt));held.angle+=dx*.006;held.spin=Math.max(-.18,Math.min(.18,dx*.001));
    }else{
      document.body.dataset.deskHover=String(!interactive(event.target)&&!!hit(event.clientX,event.clientY));
      bodies.forEach(body=>applyPointerImpulse(body,event.clientX,event.clientY,dx,dy));
    }
    particles.forEach(p=>scatterParticle(p,event.clientX,event.clientY,130,.3));
    pointer={x:event.clientX,y:event.clientY,time:now};wake();
  },{passive:true});
  document.addEventListener('pointerup',event=>{
    if(heldPointer!==undefined&&heldPointer!==event.pointerId)return;
    if(held&&performance.now()-pointer.time>80)held.vx=held.vy=held.spin=0;
    release();wake();
  });
  document.addEventListener('pointercancel',event=>{if(heldPointer===event.pointerId){if(held)held.vx=held.vy=held.spin=0;release();wake();}});
  window.addEventListener('blur',()=>{release();fieldPointer.active=false;wake();});
  document.addEventListener('pointerleave',()=>{fieldPointer.active=false;wake();});
  window.addEventListener('scroll',()=>{
    const now=performance.now(),y=window.scrollY,delta=y-lastScrollY,elapsed=Math.max(8,now-lastScrollTime);
    scrollProgress=Math.max(0,Math.min(1,y/Math.max(1,document.documentElement.scrollHeight-innerHeight)));
    if(Math.abs(delta)>1&&!reduced.matches)applyScrollImpulse(bodies,delta,elapsed);
    lastScrollY=y;lastScrollTime=now;invalidate();
  },{passive:true});
  function resize(){
    width=document.documentElement.clientWidth;height=innerHeight;
    const dpr=Math.min(devicePixelRatio||1,1.5);canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);
    canvas.parentElement!.style.height=`${height}px`;
    // Initialize only once. Resizing clamps the same bodies and particle homes.
    if(!bodies.length){cacheObstacles();geometryDirty=false;place();}
    else bodies.forEach(body=>clampToViewport(body,width,height));
    if(!particles.length)particles=placeParticles();
    else particles.forEach(p=>{clampToViewport(p,width,height,2);const home={x:p.hx,y:p.hy};clampToViewport(home,width,height,2);p.hx=home.x;p.hy=home.y;});
    canvas.dataset.particles=String(particles.length);
  }
  window.addEventListener('resize',()=>invalidate(true),{passive:true});
  const observer=new ResizeObserver(()=>invalidate());
  document.querySelectorAll('main, .header, .footer, .figure, main h1, main h2, main h3, main p, main button, main input, main textarea, dialog').forEach(el=>observer.observe(el));
  new MutationObserver(()=>invalidate()).observe(document.querySelector('main')!,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['hidden','open','class','style']});
  document.querySelectorAll('dialog').forEach(el=>new MutationObserver(()=>invalidate()).observe(el,{attributes:true,attributeFilter:['open','style']}));
  document.fonts.ready.then(()=>invalidate());
  document.fonts.addEventListener('loadingdone',()=>invalidate());
  reduced.addEventListener('change',()=>{release();fieldPointer.active=false;bodies.forEach(body=>{body.vx=body.vy=body.spin=0;});particles.forEach(p=>{p.x=p.hx;p.y=p.hy;p.vx=p.vy=0;});invalidate();});
  document.addEventListener('visibilitychange',wake);
  wake();
}
</script>
<style is:global>
body[data-desk-hover=true]{cursor:grab}
body[data-desk-dragging=true]{cursor:grabbing;user-select:none}
</style>
