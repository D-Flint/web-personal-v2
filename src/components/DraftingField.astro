<div class="drafting-field" aria-hidden="true" data-background="particles-workbench">
  <canvas id="drafting-canvas"> </canvas>
</div>
<script>
  import {
    stepDesk,
    clampToViewport,
    clearanceOpacity,
    easeOpacity,
    applyPointerImpulse,
    applyScrollImpulse,
    scatterParticle,
    stepParticle,
  } from '../utils/backgroundPhysics.mjs';
  // Read this module in six parts: state → content clearance → drawing → physics
  // → pointer input → lifecycle. The physics formulas live in backgroundPhysics.mjs.
  // A reactive particle field and a small physical workbench share the paper.
  // Reading clearance affects opacity only; input is local and physics stays in viewport space.
  const canvas = document.querySelector<HTMLCanvasElement>('#drafting-canvas')!;
  const context = canvas.getContext('2d');
  if (context) {
    const ctx = context;
    // 1. Scene state. Positions use viewport CSS pixels, not canvas backing-store pixels.
    // Bodies are desk objects; particles return to their hx/hy home coordinates.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    // vx/vy are velocity per 60 Hz step; angle/spin are radians and radians per step.
    // radius controls collisions, opacity protects text, and depth adds drawn-only parallax.
    type Body = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      angle: number;
      spin: number;
      radius: number;
      kind: string;
      opacity: number;
      depth: number;
      scrollWeight: number;
      scrollSway: number;
      scrollSpin: number;
    };
    type Rect = { x: number; y: number; width: number; height: number };
    let width = 0,
      height = 0,
      frame = 0,
      last = 0,
      geometryDirty = true,
      viewportDirty = true,
      ambientTime = 0;
    let bodies: Body[] = [],
      obstacles: Rect[] = [];
    type Particle = {
      x: number;
      y: number;
      hx: number;
      hy: number;
      vx: number;
      vy: number;
      opacity: number;
    };
    let particles: Particle[] = [];
    let accumulator = 0;
    let fieldPointer = { x: -1000, y: -1000, active: false };
    let held: Body | undefined;
    let pointer = { x: 0, y: 0, time: 0 };
    let grip = { x: 0, y: 0 };
    let heldPointer: number | undefined;
    let paintTime = performance.now();
    let lastScrollY = window.scrollY,
      lastScrollTime = performance.now(),
      scrollProgress = Math.max(
        0,
        Math.min(
          1,
          window.scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight),
        ),
      );
    const linkOpacity = new Map<string, number>();
    const palette = {
      paper: '',
      blue: '',
      ink: '',
      side: '',
      ground: '',
      line: '',
      wood: '',
      highlight: '',
      shadow: '',
    };
    // Read theme colors once per theme change instead of during every draw operation.
    function updatePalette() {
      const css = getComputedStyle(document.documentElement);
      const read = (name: string) => css.getPropertyValue(name).trim();
      Object.assign(palette, {
        paper: read('--white'),
        blue: read('--technical'),
        ink: read('--muted'),
        side: read('--piece-side'),
        ground: read('--paper'),
        line: read('--line'),
        wood: read('--wood'),
        highlight: read('--pencil-highlight'),
        shadow: read('--shadow'),
      });
    }
    updatePalette();
    document.addEventListener('theme-change', () => {
      updatePalette();
      renderScene(0);
    });

    // 2. Protect readable content by fading decoration over its measured rectangles.
    // These rectangles affect opacity; they are not physical walls for the objects.
    function canAnimate() {
      return !document.hidden && !reduced.matches;
    }
    // Cache content rectangles outside the simulation loop to avoid repeated layout reads.
    function cacheObstacles() {
      obstacles = [];
      const add = (rect: DOMRect) => {
        if (rect.width && rect.height && rect.bottom > 0 && rect.top < height)
          obstacles.push({
            x: rect.left - 5,
            y: rect.top - 5,
            width: rect.width + 10,
            height: rect.height + 10,
          });
      };
      document
        .querySelectorAll<HTMLElement>(
          '.header, .hero-pixel-field, .motion-heading, .figure, main button, main a, main input, main textarea, main summary, main .tags, .form-actions, .assistant-launcher, dialog[open]',
        )
        .forEach((el) => add(el.getBoundingClientRect()));
      document
        .querySelectorAll<HTMLElement>('main h1, main h2, main h3, main p, .footer')
        .forEach((el) => {
          const range = document.createRange();
          range.selectNodeContents(el);
          Array.from(range.getClientRects()).forEach(add);
        });
    }
    function overlapsContent(body: Body, rect: Rect) {
      const x = Math.max(rect.x, Math.min(body.x, rect.x + rect.width));
      const y = Math.max(rect.y, Math.min(body.y, rect.y + rect.height));
      return Math.hypot(body.x - x, body.y - y) < body.radius + 2;
    }
    // Choose initial positions with room around text and other desk pieces.
    // If no empty position exists, retain the best candidate rather than retry forever.
    function placeDeskObjects() {
      const mobile = width < 700;
      const kinds = mobile
        ? ['key', 'washer', 'clip', 'pencil']
        : ['key', 'washer', 'clip', 'pencil', 'brace', 'washer', 'clip', 'key'];
      const placed: Body[] = [];
      bodies = kinds.map((kind, i) => {
        const radius = mobile ? (kind === 'pencil' ? 16 : 12) : kind === 'pencil' ? 30 : 22;
        const body: Body = {
          kind,
          radius,
          x: 0,
          y: 0,
          vx: 0,
          vy: 0,
          angle: ((i % 3) - 1) * 0.32,
          spin: 0,
          opacity: 1,
          depth: (Math.random() - 0.5) * 10,
          scrollWeight: 0.7 + Math.random() * 0.6,
          scrollSway: (Math.random() - 0.5) * 0.22,
          scrollSpin: (Math.random() - 0.5) * 0.018,
        };
        // Sample open paper independently on each visit; maximize clearance if the page is crowded.
        let bestX = width / 2,
          bestY = height / 2,
          bestClearance = -Infinity;
        for (let attempt = 0; attempt < 240; attempt++) {
          body.x = radius + 8 + Math.random() * Math.max(1, width - radius * 2 - 16);
          body.y = radius + 8 + Math.random() * Math.max(1, height - radius * 2 - 16);
          let clearance = Infinity;
          for (const rect of obstacles) {
            const x = Math.max(rect.x, Math.min(body.x, rect.x + rect.width)),
              y = Math.max(rect.y, Math.min(body.y, rect.y + rect.height));
            clearance = Math.min(clearance, Math.hypot(body.x - x, body.y - y) - radius);
          }
          for (const other of placed)
            clearance = Math.min(
              clearance,
              Math.hypot(body.x - other.x, body.y - other.y) - radius - other.radius - 8,
            );
          if (clearance > bestClearance) {
            bestX = body.x;
            bestY = body.y;
            bestClearance = clearance;
          }
          if (clearance >= 18) break;
        }
        body.x = bestX;
        body.y = bestY;
        clampToViewport(body, width, height);
        placed.push(body);
        return body;
      });
      canvas.dataset.objects = String(bodies.length);
    }
    // 3. Draw the scene. Object paths use a small local coordinate system;
    // translating, rotating, and scaling the context places each object in the viewport.
    function roundRect(x: number, y: number, w: number, h: number, r: number) {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
    }
    // These shape helpers draw around (0, 0). drawDeskObject supplies the object's
    // position, angle, scale, colors, and shadow before calling the matching helper.
    function drawKeycap(kind: string) {
      roundRect(-18, -18, 36, 36, 5);
      ctx.fill();
      ctx.shadowColor = 'transparent';
      ctx.stroke();
      ctx.fillStyle = palette.side;
      roundRect(-14, -12, 28, 27, 3);
      ctx.fill();
      ctx.fillStyle = palette.paper;
      roundRect(-14, -15, 28, 26, 3);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = palette.blue;
      ctx.font = '14px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(kind === 'brace' ? '{}' : 'esc', 0, -1);
    }
    function drawWasher() {
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const angle = (i * Math.PI) / 3;
        const x = Math.cos(angle) * 19,
          y = Math.sin(angle) * 19;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.closePath();
      ctx.fill();
      ctx.shadowColor = 'transparent';
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, 0, 9, 0, Math.PI * 2);
      ctx.fillStyle = palette.ground;
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, 0, 12, 0, Math.PI * 2);
      ctx.strokeStyle = palette.line;
      ctx.stroke();
    }
    function drawPaperclip() {
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(3, -12);
      ctx.lineTo(3, 10);
      ctx.bezierCurveTo(3, 18, -9, 18, -9, 10);
      ctx.lineTo(-9, -12);
      ctx.bezierCurveTo(-9, -23, 10, -23, 10, -12);
      ctx.lineTo(10, 12);
      ctx.bezierCurveTo(10, 27, -16, 27, -16, 12);
      ctx.lineTo(-16, -8);
      ctx.stroke();
    }
    function drawPencil() {
      ctx.fillStyle = palette.blue;
      roundRect(-22, -4, 39, 8, 1);
      ctx.fill();
      ctx.shadowColor = 'transparent';
      ctx.fillStyle = palette.wood;
      ctx.beginPath();
      ctx.moveTo(17, -4);
      ctx.lineTo(26, 0);
      ctx.lineTo(17, 4);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = palette.ink;
      ctx.beginPath();
      ctx.moveTo(23, -1.5);
      ctx.lineTo(26, 0);
      ctx.lineTo(23, 1.5);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = palette.highlight;
      ctx.beginPath();
      ctx.moveTo(-20, -1);
      ctx.lineTo(15, -1);
      ctx.stroke();
      ctx.fillStyle = palette.side;
      ctx.fillRect(-26, -4, 5, 8);
    }
    function drawDeskObject(body: Body) {
      const size = body.radius / (body.kind === 'pencil' || body.kind === 'clip' ? 28 : 22);
      ctx.save();
      ctx.globalAlpha = body.opacity;
      ctx.translate(body.x, displayedBodyY(body));
      ctx.rotate(body.angle);
      ctx.scale(size, size);
      ctx.lineWidth = 1.15;
      ctx.strokeStyle = palette.blue;
      ctx.fillStyle = palette.paper;
      ctx.shadowColor = palette.shadow;
      ctx.shadowBlur = 5;
      ctx.shadowOffsetY = 3;
      switch (body.kind) {
        case 'key':
        case 'brace':
          drawKeycap(body.kind);
          break;
        case 'washer':
          drawWasher();
          break;
        case 'clip':
          drawPaperclip();
          break;
        default:
          drawPencil();
      }
      ctx.restore();
    }
    // Fade content clearance over time so moving text does not make objects blink.
    function updateOpacity(el: { opacity: number }, target: number, elapsed: number) {
      el.opacity = reduced.matches ? target : easeOpacity(el.opacity, target, elapsed);
      return el.opacity !== target;
    }
    // Paint particles and nearby connecting lines first, then desk pieces above them.
    // Return whether any opacity is still approaching its target.
    function renderScene(elapsed = 16.67) {
      ctx.clearRect(0, 0, width, height);
      let fading = false;
      for (const body of bodies)
        fading =
          updateOpacity(
            body,
            clearanceOpacity(
              { x: body.x, y: displayedBodyY(body) },
              obstacles,
              body.radius * 1.25 + 5,
            ),
            elapsed,
          ) || fading;
      for (const p of particles)
        fading = updateOpacity(p, clearanceOpacity(p, obstacles, 7), elapsed) || fading;
      const liveLinks = new Set<string>();
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const near =
          fieldPointer.active && Math.hypot(p.x - fieldPointer.x, p.y - fieldPointer.y) < 155;
        ctx.globalAlpha = p.opacity;
        ctx.globalAlpha = p.opacity * (near ? 0.65 : 0.27);
        ctx.fillStyle = palette.blue;
        ctx.beginPath();
        ctx.arc(p.x, p.y, near ? 2 : 1.3, 0, Math.PI * 2);
        ctx.fill();
        if (!near) continue;
        let links = 0;
        for (let j = i + 1; j < particles.length && links < 3; j++) {
          const q = particles[j],
            distance = Math.hypot(p.x - q.x, p.y - q.y);
          if (distance >= 100) continue;
          // Fade the whole trace if any part crosses protected content.
          let target = Math.min(p.opacity, q.opacity);
          const samples = Math.max(1, Math.ceil(distance / 8));
          for (let k = 0; k <= samples; k++)
            target = Math.min(
              target,
              clearanceOpacity(
                { x: p.x + ((q.x - p.x) * k) / samples, y: p.y + ((q.y - p.y) * k) / samples },
                obstacles,
                7,
              ),
            );
          const key = `${i}:${j}`,
            previous = linkOpacity.get(key) ?? 0;
          const alpha = reduced.matches ? target : easeOpacity(previous, target, elapsed);
          linkOpacity.set(key, alpha);
          liveLinks.add(key);
          fading = alpha !== target || fading;
          ctx.globalAlpha = alpha * 0.16 * (1 - distance / 100);
          ctx.strokeStyle = palette.blue;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(q.x, q.y);
          ctx.stroke();
          links++;
        }
      }
      for (const key of linkOpacity.keys()) if (!liveLinks.has(key)) linkOpacity.delete(key);
      ctx.globalAlpha = 1;
      bodies.forEach(drawDeskObject);
      return fading;
    }
    // 4. Advance one 60 Hz physics step. RAF may call this several times per frame.
    // Ambient drift is gentle; pointer throws and collisions are resolved by stepDesk.
    function advancePhysicsStep() {
      // Persistent gentle currents vary by piece; hidden time never advances them.
      ambientTime += 1 / 60;
      for (const [index, body] of bodies.entries()) {
        if (body === held) continue;
        const phase = body.scrollWeight * 10 + index;
        body.x += Math.cos(ambientTime * 0.27 + phase) * 0.15;
        body.y += Math.sin(ambientTime * 0.23 + phase) * 0.15;
        body.angle += Math.sin(ambientTime * 0.19 + phase) * 0.0005;
      }
      let moving = stepDesk(bodies, { width, height, held, dt: 1 });
      for (const p of particles) moving = stepParticle(p) || moving;
      return moving;
    }
    // Layout observers mark caches dirty. Read their geometry once before drawing.
    function refreshGeometry() {
      if (viewportDirty) {
        resizeScene();
        viewportDirty = false;
      }
      if (geometryDirty) {
        cacheObstacles();
        geometryDirty = false;
      }
    }
    // Accumulate elapsed time into fixed physics steps; rendering follows the browser frame rate.
    function animateSceneFrame(time: number) {
      frame = 0;
      refreshGeometry();
      const elapsed = Math.min(50, time - paintTime);
      paintTime = time;
      if (!canAnimate()) {
        renderScene(elapsed);
        canvas.dataset.animating = 'false';
        return;
      }
      accumulator += Math.min(50, time - last);
      last = time;
      while (accumulator >= 16.67) {
        advancePhysicsStep();
        accumulator -= 16.67;
      }
      renderScene(elapsed);
      // Ambient floating continues even after interaction impulses settle.
      frame = requestAnimationFrame(animateSceneFrame);
      canvas.dataset.animating = String(!!frame);
    }
    // Keep at most one animation request alive. Hidden/reduced-motion scenes stop
    // advancing physics; resuming starts a fresh clock instead of replaying missed time.
    function updateAnimationPlayback() {
      canvas.dataset.running = String(canAnimate());
      if (!canAnimate()) {
        cancelAnimationFrame(frame);
        frame = 0;
        releaseDraggedBody();
        fieldPointer.active = false;
        canvas.dataset.animating = 'false';
        if (reduced.matches && !document.hidden) {
          refreshGeometry();
          renderScene();
        }
        return;
      }
      if (!frame) {
        last = performance.now();
        paintTime = last;
        accumulator = 0;
        frame = requestAnimationFrame(animateSceneFrame);
        canvas.dataset.animating = String(canAnimate());
      }
    }
    function invalidateGeometry(viewport = false) {
      geometryDirty = true;
      viewportDirty = viewportDirty || viewport;
      updateAnimationPlayback();
    }
    // Parallax changes only the drawn Y position; the collision solver keeps its own Y.
    function displayedBodyY(body: Body) {
      return reduced.matches
        ? body.y
        : Math.max(
            body.radius,
            Math.min(height - body.radius, body.y + body.depth * scrollProgress),
          );
    }

    // Spread particle homes across the viewport without a rigid visible grid.
    function placeParticles() {
      const count = width < 700 ? 36 : 80;
      const spacing = 0.45 * Math.sqrt((width * height) / count);
      // Mulberry32: a fixed seed makes reloads reproducible, with separate X/Y samples.
      let seed = 0x484f4555;
      function random() {
        let value = (seed = (seed + 0x6d2b79f5) >>> 0);
        value = Math.imul(value ^ (value >>> 15), value | 1);
        value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
        return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
      }
      const placed: Particle[] = [];
      for (let i = 0; i < count; i++) {
        let best = { x: 0, y: 0 },
          bestClearance = -1;
        for (let attempt = 0; attempt < 64; attempt++) {
          const candidate = { x: random() * width, y: random() * height };
          let clearance = Infinity;
          for (const other of placed)
            clearance = Math.min(
              clearance,
              Math.hypot(candidate.x - other.x, candidate.y - other.y),
            );
          if (clearance > bestClearance) {
            best = candidate;
            bestClearance = clearance;
          }
          if (clearance >= spacing) break;
        }
        const { x, y } = best;
        placed.push({ x, y, hx: x, hy: y, vx: 0, vy: 0, opacity: 1 });
      }
      return placed;
    }
    // 5. Pointer input. Hit-test the last-drawn object first so stacking feels natural.
    function findBodyAtPoint(x: number, y: number) {
      return [...bodies]
        .reverse()
        .find(
          (body) =>
            body.opacity > 0.15 &&
            Math.hypot(body.x - x, displayedBodyY(body) - y) < body.radius + 5,
        );
    }
    function isInteractiveElement(target: EventTarget | null) {
      return (
        target instanceof Element &&
        !!target.closest('a,button,input,textarea,select,summary,dialog,figure,nav')
      );
    }
    function releaseDraggedBody() {
      if (heldPointer !== undefined && document.body.hasPointerCapture(heldPointer))
        document.body.releasePointerCapture(heldPointer);
      heldPointer = undefined;
      held = undefined;
      delete document.body.dataset.deskDragging;
      delete document.body.dataset.deskHover;
      canvas.dataset.interaction = 'idle';
    }
    // Mouse input grabs a body with pointer capture. Touch adds a short impulse
    // instead of capture, leaving normal page scrolling available.
    document.addEventListener('pointerdown', (event) => {
      if (!canAnimate() || held || isInteractiveElement(event.target) || event.button !== 0) return;
      particles.forEach((p) => scatterParticle(p, event.clientX, event.clientY, 230, 7));
      updateAnimationPlayback();
      const body = findBodyAtPoint(event.clientX, event.clientY);
      if (!body) return;
      if (event.pointerType === 'touch') {
        body.vx += (event.clientX < width / 2 ? 1 : -1) * 3;
        body.vy -= 2;
        body.spin += 0.12;
        updateAnimationPlayback();
        return;
      }
      held = body;
      heldPointer = event.pointerId;
      document.body.setPointerCapture(event.pointerId);
      grip = { x: event.clientX - body.x, y: event.clientY - displayedBodyY(body) };
      pointer = { x: event.clientX, y: event.clientY, time: performance.now() };
      body.vx = body.vy = 0;
      document.body.dataset.deskDragging = 'true';
      canvas.dataset.interaction = 'dragging';
      event.preventDefault();
      updateAnimationPlayback();
    });
    // While dragging, derive release velocity from recent pointer movement.
    // Otherwise only nearby bodies and particles receive a small local impulse.
    document.addEventListener(
      'pointermove',
      (event) => {
        if (
          !canAnimate() ||
          event.pointerType === 'touch' ||
          (heldPointer !== undefined && heldPointer !== event.pointerId)
        )
          return;
        const now = performance.now(),
          dx = held || fieldPointer.active ? event.clientX - pointer.x : 0,
          dy = held || fieldPointer.active ? event.clientY - pointer.y : 0;
        fieldPointer = { x: event.clientX, y: event.clientY, active: true };
        if (held) {
          held.x = event.clientX - grip.x;
          held.y = event.clientY - grip.y - held.depth * scrollProgress;
          clampToViewport(held, width, height);
          const dt = Math.max(1, (now - pointer.time) / 16.67);
          held.vx = Math.max(-14, Math.min(14, dx / dt));
          held.vy = Math.max(-14, Math.min(14, dy / dt));
          held.angle += dx * 0.006;
          held.spin = Math.max(-0.18, Math.min(0.18, dx * 0.001));
        } else {
          document.body.dataset.deskHover = String(
            !isInteractiveElement(event.target) && !!findBodyAtPoint(event.clientX, event.clientY),
          );
          bodies.forEach((body) => applyPointerImpulse(body, event.clientX, event.clientY, dx, dy));
        }
        particles.forEach((p) => scatterParticle(p, event.clientX, event.clientY, 130, 0.3));
        pointer = { x: event.clientX, y: event.clientY, time: now };
        updateAnimationPlayback();
      },
      { passive: true },
    );
    // A pause before release cancels the throw, allowing a body to be placed gently.
    document.addEventListener('pointerup', (event) => {
      if (heldPointer !== undefined && heldPointer !== event.pointerId) return;
      if (held && performance.now() - pointer.time > 80) held.vx = held.vy = held.spin = 0;
      releaseDraggedBody();
      updateAnimationPlayback();
    });
    document.addEventListener('pointercancel', (event) => {
      if (heldPointer === event.pointerId) {
        if (held) held.vx = held.vy = held.spin = 0;
        releaseDraggedBody();
        updateAnimationPlayback();
      }
    });
    window.addEventListener('blur', () => {
      releaseDraggedBody();
      fieldPointer.active = false;
      updateAnimationPlayback();
    });
    document.addEventListener('pointerleave', () => {
      fieldPointer.active = false;
      updateAnimationPlayback();
    });
    window.addEventListener(
      'scroll',
      () => {
        const now = performance.now(),
          y = window.scrollY,
          delta = y - lastScrollY,
          elapsed = Math.max(8, now - lastScrollTime);
        scrollProgress = Math.max(
          0,
          Math.min(1, y / Math.max(1, document.documentElement.scrollHeight - innerHeight)),
        );
        if (Math.abs(delta) > 1 && !reduced.matches) applyScrollImpulse(bodies, delta, elapsed);
        lastScrollY = y;
        lastScrollTime = now;
        invalidateGeometry();
      },
      { passive: true },
    );
    // 6. Viewport and DOM lifecycle. Scale the backing canvas for sharp rendering,
    // while all scene coordinates remain in CSS pixels. Preserve objects on resize.
    function resizeScene() {
      width = document.documentElement.clientWidth;
      height = innerHeight;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      canvas.parentElement!.style.height = `${height}px`;
      // Initialize only once. Resizing clamps the same bodies and particle homes.
      if (!bodies.length) {
        cacheObstacles();
        geometryDirty = false;
        placeDeskObjects();
      } else bodies.forEach((body) => clampToViewport(body, width, height));
      if (!particles.length) particles = placeParticles();
      else
        particles.forEach((p) => {
          clampToViewport(p, width, height, 2);
          const home = { x: p.hx, y: p.hy };
          clampToViewport(home, width, height, 2);
          p.hx = home.x;
          p.hy = home.y;
        });
      canvas.dataset.particles = String(particles.length);
    }
    window.addEventListener('resize', () => invalidateGeometry(true), { passive: true });
    // Text, filters, dialogs, fonts, and layout changes can all move protected content.
    // Observers invalidate cached bounds; they do not read layout or simulate directly.
    const observer = new ResizeObserver(() => invalidateGeometry());
    document
      .querySelectorAll(
        'main, .header, .footer, .figure, main h1, main h2, main h3, main p, main button, main input, main textarea, dialog',
      )
      .forEach((el) => observer.observe(el));
    new MutationObserver(() => invalidateGeometry()).observe(document.querySelector('main')!, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: ['hidden', 'open', 'class', 'style'],
    });
    document.querySelectorAll('dialog').forEach((el) =>
      new MutationObserver(() => invalidateGeometry()).observe(el, {
        attributes: true,
        attributeFilter: ['open', 'style'],
      }),
    );
    document.fonts.ready.then(() => invalidateGeometry());
    document.fonts.addEventListener('loadingdone', () => invalidateGeometry());
    reduced.addEventListener('change', () => {
      releaseDraggedBody();
      fieldPointer.active = false;
      bodies.forEach((body) => {
        body.vx = body.vy = body.spin = 0;
      });
      particles.forEach((p) => {
        p.x = p.hx;
        p.y = p.hy;
        p.vx = p.vy = 0;
      });
      invalidateGeometry();
    });
    document.addEventListener('visibilitychange', updateAnimationPlayback);
    updateAnimationPlayback();
  }
</script>
<style is:global>
  body[data-desk-hover='true'] {
    cursor: grab;
  }
  body[data-desk-dragging='true'] {
    cursor: grabbing;
    user-select: none;
  }
</style>
