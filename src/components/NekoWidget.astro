<button class="button assistant-launcher" id="assistant-open" aria-haspopup="dialog" aria-controls="neko-chat" aria-label="Ask about my work" title="Ask about my work"><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16v12H9l-5 4V4zM8 8h8m-8 4h5"/></svg><span class="sr-only">Ask about my work</span></button>
<dialog id="neko-chat" class="assistant-dialog" aria-labelledby="assistant-title"><div class="flex h-full min-h-0 flex-col overflow-hidden assistant-shell"><div class="assistant-header"><div><h2 id="assistant-title">Portfolio assistant</h2><p>Ask about Hoeurb’s work and experience.</p></div><button id="assistant-close" class="icon-button" aria-label="Close assistant"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div><div id="chat-log" class="chat-log" role="log" aria-label="Conversation" aria-live="polite" aria-relevant="additions text"><div class="chat-message"><strong>Assistant</strong>What would you like to know about Hoeurb’s projects, skills, or background?</div></div><div class="chat-prompts"><button data-prompt="Tell me about your AI assistant project.">AI assistant</button><button data-prompt="What are your technical skills?">Technical skills</button><button data-prompt="How can I contact Hoeurb?">Contact</button></div><p class="chat-status" id="chat-status" role="status"></p><button class="button secondary chat-retry" id="chat-retry" hidden>Retry message</button><form class="chat-form" id="chat-form"><label for="chat-input"><span>Your question · up to 250 characters</span><textarea id="chat-input" maxlength="250" required rows="2" placeholder="Ask a question…"></textarea></label><button class="button" id="chat-send" type="submit">Send</button></form><button class="chat-reset" id="chat-reset">Clear conversation</button></div></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#neko-chat')!;
const input=document.querySelector<HTMLTextAreaElement>('#chat-input')!;
const log=document.querySelector<HTMLElement>('#chat-log')!;
const status=document.querySelector<HTMLElement>('#chat-status')!;
const send=document.querySelector<HTMLButtonElement>('#chat-send')!;
const retry=document.querySelector<HTMLButtonElement>('#chat-retry')!;
const reset=document.querySelector<HTMLButtonElement>('#chat-reset')!;
const launcher=document.querySelector<HTMLButtonElement>('#assistant-open')!;
let history:{role:'user'|'assistant';content:string}[]=[];let failed='';let controller:AbortController|undefined;
launcher.addEventListener('click',()=>{dialog.showModal();resize();input.focus();});document.querySelector('#assistant-close')!.addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>launcher.focus());
function resize(){if(!dialog.open)return;const v=window.visualViewport;if(v){const available=v.height-24;dialog.style.maxHeight=`${available}px`;dialog.style.bottom=`${Math.max(12,window.innerHeight-v.height-v.offsetTop+12)}px`;}}
window.visualViewport?.addEventListener('resize',resize);window.visualViewport?.addEventListener('scroll',resize);
function message(role:string,text:string){const item=document.createElement('div');item.className=`chat-message ${role}`;const label=document.createElement('strong');label.textContent=role==='user'?'You':'Assistant';const content=document.createElement('span');content.textContent=text;item.append(label,content);log.append(item);log.scrollTop=log.scrollHeight;return {item,content};}
async function ask(text:string,isRetry=false){if(send.disabled||!text.trim())return;text=text.trim().slice(0,250);if(!isRetry)message('user',text);failed='';retry.hidden=true;send.disabled=true;reset.disabled=true;input.disabled=true;document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach(b=>b.disabled=true);status.dataset.state='pending';status.textContent='Connecting to the assistant…';const answer=message('assistant','');log.setAttribute('aria-busy','true');controller=new AbortController();const timer=setTimeout(()=>controller?.abort(),45000);try{const response=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:[...history.slice(-6),{role:'user',content:text}]}),signal:controller.signal});if(!response.ok){const data=await response.json().catch(()=>({}));throw new Error(response.status===503?'Chat needs a server API key. You can still contact Hoeurb by email.':data.error||'The assistant couldn’t respond. Please retry.');}if(!response.body)throw new Error('No response received. Please retry.');status.textContent='Assistant is responding…';const reader=response.body.getReader();const decoder=new TextDecoder();let reply='';while(true){const {done,value}=await reader.read();if(done)break;reply+=decoder.decode(value,{stream:true});answer.content.textContent=reply;log.scrollTop=log.scrollHeight;}reply+=decoder.decode();answer.content.textContent=reply;if(!reply.trim())throw new Error('The assistant returned an empty response. Please retry.');history.push({role:'user',content:text},{role:'assistant',content:reply});input.value='';status.textContent='Response complete.';status.dataset.state='success';}catch(error){answer.item.remove();failed=text;status.textContent=error instanceof Error&&error.name!=='AbortError'?error.message:'The connection timed out. Please retry your message.';status.dataset.state='error';retry.hidden=false;}finally{clearTimeout(timer);log.removeAttribute('aria-busy');send.disabled=false;reset.disabled=false;input.disabled=false;document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach(b=>b.disabled=false);if(dialog.open)input.focus();}}
document.querySelector('#chat-form')!.addEventListener('submit',e=>{e.preventDefault();ask(input.value);});input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();ask(input.value);}});retry.addEventListener('click',()=>ask(failed,true));document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach(b=>b.addEventListener('click',()=>ask(b.dataset.prompt!)));reset.addEventListener('click',()=>{history=[];failed='';retry.hidden=true;log.replaceChildren();message('assistant','Conversation cleared. What would you like to know?');status.textContent='';input.value='';input.focus();});
</script>
