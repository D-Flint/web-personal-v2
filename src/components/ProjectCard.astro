---
// ──────────────────────────────────────────────────────────────────────────────
//  ProjectCard.astro — Unified Grand Narukami Shrine Project Card
// ──────────────────────────────────────────────────────────────────────────────
//  ONE shared card design system used by BOTH the Home "Featured Projects" grid
//  (ProjectGrid.astro) and the /projects Archive (projects.astro). Each page only
//  differs in its grid wrapper + (archive-only) grid/list toggle.
//
//  IMAGE AREA:
//  The `.card-media` block at the top is an intentional EMPTY placeholder. To add
//  artwork later, drop an <img class="card-media-img" src="..." /> inside it — no
//  other structural change needed. No artwork / decorative gradients are shipped.
//
//  Props: { project, index, critical }
//    project.icon MUST be a full <svg>…</svg> string (use the iconSvg() helper).
// ──────────────────────────────────────────────────────────────────────────────
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import sakuraFlower from '../assets/images/sakura-flower.webp';
import CatEar from './CatEar.astro';
import TagPill from './TagPill.astro';

interface Project {
  num: string;
  title: string;
  description: string;
  tags: string[];
  features?: string[];
  domain: string;
  domainLabel: string;
  poem?: string;
  icon: string;
  liveUrl?: string;
  sourceUrl?: string;
  image?: ImageMetadata | string;
}

const { project, index = 0, critical = false } = Astro.props as { project: Project; index?: number; critical?: boolean };
const { num, title, description, tags = [], features = [], domain, domainLabel, poem, icon, liveUrl, sourceUrl, image } = project;
---

<article
  data-project-index={index}
  data-num={num}
  data-title={title}
  data-description={description}
  data-tags={JSON.stringify(tags)}
  data-features={JSON.stringify(features)}
  data-domain={domain}
  data-domain-label={domainLabel}
  data-live-url={liveUrl ?? ''}
  data-source-url={sourceUrl ?? ''}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
  aria-label={`View details for ${title}`}
  class={`project-card domain-${domain} group relative flex flex-col overflow-visible rounded-2xl border p-3 sm:p-3.5 opacity-0 translate-y-8 backdrop-blur-xl transition-all duration-200 ease-out hover:-translate-y-1 active:scale-[0.985] will-change-transform cursor-pointer`}
>
  <!-- Cat ears (reveal on hover) -->
  <div class="card-ear-container pointer-events-none absolute left-0 right-0 top-0 z-30 flex justify-between px-5 sm:px-7 -translate-y-[60%] opacity-0 transition-opacity duration-200 group-hover:opacity-100">
    <CatEar side="left" idPrefix={`pc-${domain}-${num}`} loading="lazy" fetchpriority="low" class="card-ear card-ear-left h-20 w-28 sm:h-24 sm:w-32" />
    <CatEar side="right" idPrefix={`pc-${domain}-${num}`} loading="lazy" fetchpriority="low" class="card-ear card-ear-right h-20 w-28 sm:h-24 sm:w-32" />
  </div>

  <!-- Cursor reflection (domain accent) -->
  <div class="card-spotlight pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>

  <!-- ══════════════════ MEDIA / IMAGE AREA ══════════════════ -->
  <div class="card-media relative z-10 w-full overflow-hidden" aria-hidden="true">
    {image ? (
      typeof image === 'string' ? (
        <img
          class="card-media-img"
          src={image}
          alt=""
          loading={critical ? 'eager' : 'lazy'}
          fetchpriority={critical ? 'high' : 'auto'}
          data-loading-critical={critical ? '' : undefined}
          decoding="async"
        />
      ) : (
        <Image
          class="card-media-img"
          src={image}
          alt=""
          widths={[340, 500, 720, 960]}
          sizes="(max-width: 640px) calc(100vw - 3.5rem), (max-width: 1024px) 50vw, 380px"
          format="webp"
          quality={75}
          loading={critical ? 'eager' : 'lazy'}
          fetchpriority={critical ? 'high' : 'auto'}
          data-loading-critical={critical ? '' : undefined}
          decoding="async"
        />
      )
    ) : (
      <span class="card-media-ph" set:html={icon}></span>
    )}
  </div>

  <!-- ══════════════════ CONTENT ══════════════════ -->
  <div class="card-content relative z-10 flex flex-1 flex-col px-1.5 pt-3 pb-0.5">
    <div class="card-top flex flex-col">
      <!-- Eyebrow: icon chip + index / domain label, poem seal -->
      <div class="flex items-center justify-between gap-2.5">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="card-icon-box flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border shadow-sm backdrop-blur-md transition-all duration-200 group-hover:scale-105">
            <Fragment set:html={icon} />
          </div>
          <div class="flex items-center gap-1.5 font-mono text-xs tracking-wider min-w-0">
            <span class="font-bold text-white text-sm">{num}</span>
            <span class="text-slate-500/60">/</span>
            <span class="card-domain-label text-[10.5px] uppercase font-semibold truncate transition-colors duration-200">{domainLabel}</span>
          </div>
        </div>

        {poem && (
          <div class="card-seal hidden md:flex items-center gap-1 px-2.5 py-0.5 rounded-full border text-[11px] font-serif select-none backdrop-blur-md shadow-sm shrink-0">
            <span>{poem}</span>
            <Image src={sakuraFlower} width={10} height={10} alt="" decoding="async" class="object-contain inline-block opacity-80 group-hover:opacity-100"  densities={[1.5, 2, 3]} />
          </div>
        )}
      </div>

      <!-- Title + description -->
      <div class="card-text mt-3.5 flex-1">
        <h2 class="card-title font-serif text-lg sm:text-xl font-bold tracking-wide text-white transition-colors duration-200 group-hover:text-pink-100 line-clamp-2">
          {title}
        </h2>
        <p class="card-desc mt-2 text-xs sm:text-sm leading-relaxed text-slate-100/90 font-light line-clamp-3">
          {description}
        </p>

        {features && features.length > 0 && (
          <div class="card-feature-chip mt-3 flex items-center gap-2 rounded-lg border bg-white/[0.03] px-2.5 py-1.5 text-[11px] font-mono text-slate-200/85 backdrop-blur-sm transition-all duration-200">
            <span class="card-feature-spark text-[10px] shrink-0">✦</span>
            <span class="truncate font-light">{features[0]}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Footer: tags + actions -->
    <div class="card-bottom mt-3.5 pt-3 border-t border-pink-500/15 flex flex-col gap-3">
      <div class="card-tags flex flex-wrap items-center gap-1.5">
        {tags.map((tag) => <TagPill tag={tag} size="sm" />)}
      </div>

      <div class="card-actions flex items-center justify-between pt-0.5 text-xs font-medium">
        <div class="card-cta flex items-center gap-1.5 font-serif">
          <span class="card-cta-text">View Details</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-cta-icon transition-transform duration-200 ease-out group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>

        <!-- Verified external actions only (bypass modal via data-no-modal) -->
        {(sourceUrl || liveUrl) && (
          <div class="flex items-center gap-1.5" data-no-modal="true">
            {sourceUrl && (
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-no-modal="true"
                title={`View ${title} source code`}
                aria-label={`View ${title} source code`}
                class="card-ext-btn flex h-7.5 items-center justify-center gap-1 px-2.5 rounded-lg border text-[11px] font-mono text-slate-200 transition-all duration-200 shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                <span>Code</span>
              </a>
            )}
            {liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-no-modal="true"
                title={`Open ${title} demo`}
                aria-label={`Open ${title} demo`}
                class="card-ext-link flex h-7.5 px-2.5 items-center gap-1 rounded-lg border text-[11px] font-mono transition-all duration-200 shadow-sm"
              >
                <span>Demo</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<!-- ── Unified Project Card design system (global; shared by both pages) ── -->
<style is:global>
  /* ── DOMAIN ELEMENTAL THEMES (Systems / Web / AI / Tools) ── */
  .project-card.domain-systems { --domain-color: #34d399; --domain-rgb: 52, 211, 153; --domain-light: #a7f3d0; }
  .project-card.domain-web     { --domain-color: #f472b6; --domain-rgb: 244, 114, 182; --domain-light: #fbcfe8; }
  .project-card.domain-ai      { --domain-color: #c084fc; --domain-rgb: 192, 132, 252; --domain-light: #f3e8ff; }
  .project-card.domain-tools   { --domain-color: #fbbf24; --domain-rgb: 251, 191, 36; --domain-light: #fef3c7; }

  /* ── Card surface (one glass recipe for both pages) ── */
  .project-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    /* Fine domain-colored frame without painted white surface highlights. */
    border-radius: 1.125rem;
    background: var(--glass-fill);
    border: 1px solid rgba(var(--domain-rgb, 244, 114, 182), 0.3);
    border-top-color: rgba(var(--domain-rgb, 244, 114, 182), 0.4);
    border-bottom-color: rgba(var(--domain-rgb, 244, 114, 182), 0.24);
    box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.4);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
  }
  .project-card:hover {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.5);
    box-shadow: 0 14px 32px -12px rgba(0, 0, 0, 0.46);
  }
  .project-card:focus-visible {
    outline: none !important;
    border-color: var(--domain-color) !important;
    box-shadow:
      0 0 0 2px rgba(var(--domain-rgb, 244, 114, 182), 0.85),
      0 0 20px rgba(var(--domain-rgb, 244, 114, 182), 0.40) !important;
  }
  .project-card.revealed {
    translate: 0 !important;
  }

  /* Cursor spotlight overlay */
  .card-spotlight {
    border-radius: inherit;
    background: radial-gradient(
      340px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--domain-rgb, 244, 114, 182), 0.16),
      transparent 70%
    );
  }

  /* ── MEDIA / IMAGE AREA (empty placeholder, ready for a background image) ── */
  .card-media {
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    border: 1px solid rgba(var(--domain-rgb, 244, 114, 182), 0.16);
    background-color: rgba(255, 255, 255, 0.02);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), inset 0 0 26px rgba(0, 0, 0, 0.35);
    isolation: isolate;
    transition: border-color 0.2s ease;
  }
  .project-card:hover .card-media {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.3);
  }
  /* Image slot — drop <img class="card-media-img"> in .card-media to fill it */
  .card-media-img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    z-index: 2;
    transition: transform 0.3s ease;
  }
  .project-card:hover .card-media-img {
    transform: scale(1.03);
  }
  /* Empty-state glyph anchor (existing project icon, decorative) */
  .card-media-ph {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--domain-color, #f472b6);
    opacity: 0.16;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .card-media-ph svg { width: 46px; height: 46px; }
  .project-card:hover .card-media-ph { opacity: 0.26; transform: scale(1.04); }

  /* ── Icon chip ── */
  .card-icon-box {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.4);
    background-color: rgba(var(--domain-rgb, 244, 114, 182), 0.12);
    color: var(--domain-color);
  }
  .project-card:hover .card-icon-box {
    border-color: var(--domain-color);
    background-color: rgba(var(--domain-rgb, 244, 114, 182), 0.22);
    color: #ffffff;
  }

  .card-domain-label { color: var(--domain-color); }

  .project-card .tag-pill {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.35);
  }
  .project-card .tag-pill:hover {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.75);
  }

  /* Poem talisman seal (shrine-neutral pink) */
  .card-seal {
    border-color: rgba(244, 114, 182, 0.3);
    background-color: rgba(22, 19, 38, 0.9);
    color: rgba(251, 207, 232, 0.95);
  }

  /* Feature chip */
  .card-feature-chip {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.18);
  }
  .card-feature-chip .card-feature-spark { color: var(--domain-color); }
  .project-card:hover .card-feature-chip {
    border-color: rgba(var(--domain-rgb, 244, 114, 182), 0.35);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* CTA (View Details) */
  .card-cta { color: rgba(244, 168, 212, 0.9); }
  .project-card:hover .card-cta-text,
  .project-card:hover .card-cta-icon { color: var(--domain-light) !important; }

  /* External-link buttons */
  .card-ext-btn {
    border-color: rgba(244, 114, 182, 0.32);
    background-color: rgba(22, 19, 38, 0.9);
  }
  .card-ext-btn:hover {
    border-color: rgba(249, 168, 212, 0.8);
    background-color: rgba(244, 114, 182, 0.25);
    color: #ffffff;
  }
  .card-ext-link {
    border-color: rgba(244, 114, 182, 0.4);
    background-color: rgba(244, 114, 182, 0.18);
    color: rgba(251, 207, 232, 0.95);
  }
  .card-ext-link:hover {
    border-color: #f9a8d4;
    background-color: rgba(244, 114, 182, 0.3);
    color: #ffffff;
  }

  /* ── Cat-ear hover wiggle ── */
  @keyframes pcCardWiggleLeft {
    0% { transform: translateY(0) rotate(0deg); }
    6% { transform: translateY(-4px) rotate(-11deg); }
    14% { transform: translateY(0) rotate(3deg); }
    22% { transform: translateY(-2px) rotate(-8deg); }
    30%, 100% { transform: translateY(0) rotate(0deg); }
  }
  @keyframes pcCardWiggleRight {
    0% { transform: translateY(0) rotate(0deg); }
    6% { transform: translateY(-4px) rotate(11deg); }
    14% { transform: translateY(0) rotate(-3deg); }
    22% { transform: translateY(-2px) rotate(8deg); }
    30%, 100% { transform: translateY(0) rotate(0deg); }
  }
  .card-ear {
    transform-origin: center bottom;
    filter: drop-shadow(0 3px 8px rgba(244, 114, 182, 0.14));
    transition: filter 200ms ease;
  }
  .project-card:hover .card-ear-left {
    animation: pcCardWiggleLeft 1.5s ease-in-out infinite !important;
    filter: drop-shadow(0 6px 16px rgba(244, 114, 182, 0.4)) !important;
  }
  .project-card:hover .card-ear-right {
    animation: pcCardWiggleRight 1.5s ease-in-out infinite !important;
    filter: drop-shadow(0 6px 16px rgba(244, 114, 182, 0.4)) !important;
  }

  /* ══════════════════ ARCHIVE-ONLY: DIRECTORY LIST VIEW ══════════════════
     Applies only where the archive grid carries #project-grid.view-list. The
     media area and decorative ears collapse; the card becomes a dense row. */
  #project-grid.view-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.65rem !important;
  }
  #project-grid.view-list .project-card {
    padding: 0.75rem 1rem !important;
    border-radius: 0.875rem !important;
  }
  #project-grid.view-list .project-card:hover {
    transform: translateX(4px) !important;
  }
  #project-grid.view-list .card-media,
  #project-grid.view-list .card-ear-container,
  #project-grid.view-list .card-feature-chip {
    display: none !important;
  }
  #project-grid.view-list .card-content {
    padding: 0 !important;
  }

  /* Mobile list (<768px) */
  @media (max-width: 767px) {
    .card-seal { display: none !important; }
    #project-grid.view-list .card-top > .flex { gap: 0.5rem !important; }
    #project-grid.view-list .card-icon-box {
      height: 2rem !important; width: 2rem !important; border-radius: 0.5rem !important;
    }
    #project-grid.view-list .card-icon-box svg { width: 14px !important; height: 14px !important; }
    #project-grid.view-list .card-text { margin-top: 0.25rem !important; }
    #project-grid.view-list .card-title {
      font-size: 0.95rem !important; line-height: 1.25rem !important;
      display: -webkit-box !important; -webkit-line-clamp: 1 !important; -webkit-box-orient: vertical !important; overflow: hidden !important;
    }
    #project-grid.view-list .card-desc {
      display: -webkit-box !important; -webkit-line-clamp: 1 !important; -webkit-box-orient: vertical !important; overflow: hidden !important;
      font-size: 0.75rem !important; line-height: 1.05rem !important; margin-top: 0.2rem !important;
      color: rgba(203, 213, 225, 0.8) !important;
    }
    #project-grid.view-list .card-bottom {
      margin-top: 0.35rem !important; padding-top: 0.35rem !important;
      border-top: 1px solid rgba(244, 114, 182, 0.12) !important;
      flex-direction: row !important; align-items: center !important; justify-content: space-between !important; gap: 0.5rem !important;
    }
    #project-grid.view-list .card-tags {
      flex-wrap: nowrap !important; overflow: hidden !important; max-width: 60% !important; gap: 0.25rem !important;
      -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%) !important;
      mask-image: linear-gradient(to right, black 80%, transparent 100%) !important;
    }
    #project-grid.view-list .card-tags .tag-pill { font-size: 10px !important; padding: 2px 6px !important; }
    #project-grid.view-list .card-actions { padding-top: 0 !important; gap: 0.35rem !important; flex-shrink: 0 !important; }
    #project-grid.view-list .card-cta-text { display: none !important; }
    #project-grid.view-list .card-actions [data-no-modal="true"] a {
      height: 1.65rem !important; padding-left: 0.45rem !important; padding-right: 0.45rem !important; font-size: 10px !important;
    }
  }

  /* Desktop list (>=768px) */
  @media (min-width: 768px) {
    #project-grid.view-list { gap: 0.75rem !important; }
    #project-grid.view-list .project-card { padding: 1rem 1.4rem !important; }
    #project-grid.view-list .card-content {
      flex-direction: row !important; align-items: center !important; justify-content: space-between !important; gap: 1.5rem !important;
    }
    #project-grid.view-list .card-top { flex: 1 1 0% !important; min-width: 0 !important; }
    #project-grid.view-list .card-desc {
      display: -webkit-box !important; -webkit-line-clamp: 1 !important; -webkit-box-orient: vertical !important; overflow: hidden !important;
    }
    #project-grid.view-list .card-bottom {
      margin-top: 0 !important; padding-top: 0 !important; border-top: 0 !important;
      flex-shrink: 0 !important; flex-direction: row !important; align-items: center !important; gap: 1rem !important;
    }
    #project-grid.view-list .card-tags {
      flex-wrap: nowrap !important; overflow: hidden !important; max-width: 280px !important;
      -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%) !important;
      mask-image: linear-gradient(to right, black 85%, transparent 100%) !important;
    }
    #project-grid.view-list .card-actions { padding-top: 0 !important; }
  }
</style>

<script>
  // Shared cursor-spotlight for all .project-card instances (fine pointers only).
  (() => {
    const w = window as any;
    if (w.__pcSpotlightBound) return;
    w.__pcSpotlightBound = true;
    if (!window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;
    document.addEventListener('mousemove', (e) => {
      const card = (e.target as HTMLElement).closest('.project-card') as HTMLElement | null;
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
    }, { passive: true });
  })();
</script>
