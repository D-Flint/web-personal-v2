---
const path = Astro.url.pathname;
---

<header class="header">
  <div class="wrap masthead">
    <a class="brand" href="/" aria-label="Hoeurb Vuthi home">
      <svg
        class="brand-mark"
        viewBox="0 0 40 40"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M7 7v26M16 7v26M5 20h14m4-13 6 26 6-26"></path>
      </svg>
      <span class="brand-name">
        Hoeurb Vuthi<span class="brand-note">Developer · Phnom Penh, Cambodia</span>
      </span>
    </a>
    <nav aria-label="Main navigation">
      <a href="/#work">Selected work</a>
      <a href="/projects" aria-current={path === '/projects' ? 'page' : undefined}>
        All projects
      </a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
      <a class="resume-link" href="/resume" aria-current={path === '/resume' ? 'page' : undefined}>
        Resume
      </a>
    </nav>
    <div class="theme-controls" hidden>
      <button
        id="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Dark mode"
      >
        <span class="theme-track" aria-hidden="true">
          <span> </span>
        </span>
        <span data-theme-label> Light </span>
      </button>
    </div>
  </div>
</header>
