---
// ──────────────────────────────────────────────────────────────────────────────
//  AboutMe.astro — "About Me" Section Component
// ──────────────────────────────────────────────────────────────────────────────
//  Renders a two-column layout: biography text (left) and a technical skills
//  card (right). The skills card features decorative cat-ear SVGs with a wiggle
//  animation, a glassmorphism container, and a flex-wrap badge list.
// ──────────────────────────────────────────────────────────────────────────────
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/avatar.png';
import avatarFrameImg from '../assets/images/avatart-frame.png';
import sakuraIcon from '../assets/images/sakura-flower.webp';
import toriGateImg from '../assets/images/tori-gate.png';
import kitsuneIcon from '../assets/images/kitsune-icon.png';
import CatEar from './CatEar.astro';
import TagPill from './TagPill.astro';
import techStackBg from '../assets/images/tech-stack-bg.png';

const skills = ["C++", "Node.js", "Astro", "Tailwind", "Git", "Linux", "TypeScript", "Python", "PostgreSQL", "Docker"];
---

<style is:global>
  @keyframes pulse-slow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .animate-pulse-slow { animation: pulse-slow 3s ease-in-out infinite; }

  @keyframes avatarFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .animate-avatar-float {
    animation: avatarFloat 4.6s ease-in-out infinite;
  }

  /* Desktop Element-Level Scroll Cascade */
  @media (min-width: 769px) {
    .about-item {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 650ms cubic-bezier(0.16, 1, 0.3, 1), transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .reveal.revealed .about-item,
    .reveal.revealed.about-item {
      opacity: 1;
      transform: translateY(0);
    }

    .about-item-1 { transition-delay: 0ms; }
    .about-item-2 { transition-delay: 120ms; }
    .about-item-3 { transition-delay: 240ms; }
    .about-item-4 { transition-delay: 360ms; }
    .about-item-5 { transition-delay: 480ms; }
  }

</style>

<section id="about" class="relative w-full min-h-0 sm:min-h-[750px] lg:min-h-[850px] py-16 sm:py-24 lg:py-32 overflow-hidden flex flex-col justify-center">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Biography & Highlights (Left Column) -->
      <div class="reveal lg:col-span-7 flex flex-col items-center lg:items-start space-y-7">
        
        <!-- Header: Torii Gate + ABOUT ME Capsule -->
        <div class="about-item about-item-1 flex items-center gap-3 w-full justify-center lg:justify-start">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full liquid-glass-control shadow-sm">
            <!-- Torii Gate Icon -->
            <svg class="w-4 h-4 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 5h20M4 8h16M7 5v14M17 5v14M6 19h2M16 19h2M12 8v4" />
            </svg>
            <span class="text-xs font-mono font-bold tracking-[0.25em] text-pink-200 uppercase">
              ABOUT ME
            </span>
          </div>
          <div class="h-[1px] w-12 sm:w-20 bg-pink-500/30 hidden sm:block"></div>
        </div>

        <!-- Avatar Portrait with Grand Narukami Ornate Frame & Kitsune Silhouette -->
        <div class="about-item about-item-2 group relative flex items-center justify-center my-2 select-none cursor-pointer">
          <!-- Subtle Ambient Radial Glow -->
          <div class="absolute -inset-6 bg-gradient-to-tr from-pink-500/10 via-purple-500/5 to-transparent rounded-full blur-2xl pointer-events-none -z-10 opacity-50 transition-all duration-300 group-hover:opacity-90 group-hover:scale-110 group-hover:from-pink-500/25"></div>

          <!-- Kitsune Mask Silhouette (Background Mist Watermark) -->
          <div class="absolute -right-12 -top-8 w-40 h-40 opacity-15 pointer-events-none -z-10 rotate-12 transition-all duration-500 ease-out group-hover:opacity-25 group-hover:scale-105">
            <Image 
              src={kitsuneIcon} 
              alt="" 
              width={120} 
              height={120} 
              format="webp"
              quality={75}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-contain filter grayscale brightness-200" 
            />
          </div>

          <!-- Avatar + Ornate Frame Composite Container -->
          <div class="animate-avatar-float relative w-48 h-48 sm:w-56 sm:h-56 flex items-center justify-center transition-all duration-300 ease-out group-hover:-translate-y-1.5 group-hover:scale-[1.03] will-change-transform">
            <!-- Center Circular Avatar Image -->
            <div class="w-[70.5%] h-[70.5%] -translate-y-[1.5%] rounded-full overflow-hidden relative z-10 shadow-[0_4px_16px_rgba(0,0,0,0.5)] transition-shadow duration-300 group-hover:shadow-[0_8px_24px_rgba(0,0,0,0.6)]">
              <Image 
                src={avatarImg} 
                alt="Hoeurb Vuthi - Avatar" 
                width={180} 
                height={180} 
                format="webp"
                quality={80}
                loading="lazy" 
                decoding="async" 
                class="w-full h-full object-cover rounded-full transition-transform duration-500 ease-out group-hover:scale-105 will-change-transform" 
              />
            </div>

            <!-- Grand Narukami Ornate Frame Overlay -->
            <Image 
              src={avatarFrameImg} 
              alt="Grand Narukami Shrine Avatar Frame" 
              width={180} 
              height={180} 
              format="webp"
              quality={80}
              loading="lazy" 
              decoding="async" 
              class="absolute inset-0 w-full h-full object-contain pointer-events-none z-20 drop-shadow-[0_2px_8px_rgba(0,0,0,0.3)] transition-all duration-300 ease-out group-hover:drop-shadow-[0_0_16px_rgba(244,114,182,0.65)]" 
            />
          </div>
        </div>

        <!-- Bio Paragraphs with Clean Border-Left -->
        <div class="about-item about-item-3 border-l border-pink-500/40 pl-4 sm:pl-5 space-y-4 text-slate-200/90 text-sm sm:text-base leading-relaxed font-light text-left">
          <p>
            I&rsquo;m a Management Information Systems student and developer based in Phnom Penh, working toward becoming a full-time software developer. I got into programming out of genuine curiosity, learning how things work from the ground up starting with C++ and Linux system tooling, all the way to modern web development.
          </p>
          <p>
            Right now, I build fast, clean web apps with Astro and TypeScript, experiment with local AI models and automation, and continuously sharpen my problem-solving skills. I care about writing straightforward code, building things that feel snappy, and always learning something new every day.
          </p>
        </div>

        <!-- Highlights Information Strip (Location, Studies, Interests) -->
        <div class="sakura-glass-panel about-highlights-panel about-item about-item-4 w-full rounded-2xl border p-2 sm:px-3 sm:py-2 transition-colors duration-200 ease-out">
          <div class="grid w-full grid-cols-1 divide-y divide-pink-500/15 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            
            <!-- Location -->
            <div class="about-highlight-item grid min-w-0 grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-3 px-3 py-3 sm:px-4 sm:py-2">
              <Image 
                src={sakuraIcon} 
                alt="Location" 
                width={24} 
                height={24} 
                loading="lazy" 
                decoding="async" 
                class="w-5 h-5 object-contain"
               densities={[1.5, 2, 3]} />
              <div class="min-w-0">
                <p class="about-highlight-label mb-1 text-left font-mono leading-none">Location</p>
                <p class="about-highlight-value whitespace-nowrap text-left text-sm leading-none tracking-tight">Phnom Penh, Cambodia</p>
              </div>
            </div>

            <!-- Studies -->
            <div class="about-highlight-item grid min-w-0 grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-3 px-3 py-3 sm:px-4 sm:py-2">
              <Image 
                src={toriGateImg} 
                alt="Studies" 
                width={24} 
                height={24} 
                format="webp"
                quality={80}
                loading="lazy" 
                decoding="async" 
                class="w-5 h-5 object-contain"
              />
              <div class="min-w-0">
                <p class="about-highlight-label mb-1 text-left font-mono leading-none">Studies</p>
                <p class="about-highlight-value whitespace-nowrap text-left text-sm leading-none tracking-tight">MIS @ SETEC Institute</p>
              </div>
            </div>

            <!-- Interests -->
            <div class="about-highlight-item grid min-w-0 grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-3 px-3 py-3 sm:px-4 sm:py-2">
              <Image 
                src={kitsuneIcon} 
                alt="Interests" 
                width={24} 
                height={24} 
                format="webp"
                quality={80}
                loading="lazy" 
                decoding="async" 
                class="w-5 h-5 object-contain"
              />
              <div class="min-w-0">
                <p class="about-highlight-label mb-1 text-left font-mono leading-none">Interests</p>
                <p class="about-highlight-value whitespace-nowrap text-left text-sm leading-none tracking-tight">C++ • Linux • Web • AI</p>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Skills (Right Column) -->
      <div class="reveal lg:col-span-5 w-full">
        <div class="sakura-glass-panel tech-stack-panel project-card-hover group relative z-10 overflow-visible rounded-2xl p-6 sm:p-8 transition-all duration-200 ease-out hover:shadow-[0_16px_48px_rgba(0,0,0,0.6),0_0_35px_rgba(244,114,182,0.25)] hover:-translate-y-1.5 will-change-transform">
          
          <!-- Cat ears for Technical Stack card on hover -->
          <div class="pointer-events-none absolute left-0 right-0 top-0 z-30 flex justify-between px-3 sm:px-5 -translate-y-[65%] opacity-0 transition-opacity duration-200 group-hover:opacity-100">
            <CatEar side="left" idPrefix="stack" class="card-ear card-ear-left h-20 w-28 sm:h-24 sm:w-32" />
            <CatEar side="right" idPrefix="stack" class="card-ear card-ear-right h-20 w-28 sm:h-24 sm:w-32" />
          </div>

          <!-- Inner Clipped Artwork Layer (Tech Stack Background) -->
          <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl">
            <Image
              src={techStackBg}
              alt=""
              widths={[420, 640]}
              sizes="(max-width: 1024px) 100vw, 480px"
              format="webp"
              quality={75}
              class="h-full w-full object-cover object-center opacity-10 transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0c0b16]/20 to-[#0c0b16]/50"></div>
          </div>

          <!-- Header: Sakura Flower + Technical Stack -->
          <div class="relative z-10 flex items-center justify-between mb-6 pb-4 border-b border-pink-500/15">
            <div class="flex items-center gap-2.5">
              <Image 
                src={sakuraIcon} 
                alt="" 
                width={22} 
                height={22} 
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain" 
                decoding="async" 
               densities={[1.5, 2, 3]} />
              <h3 class="text-lg sm:text-xl font-bold font-serif text-white tracking-wide">
                Technical Stack
              </h3>
            </div>
            <span class="text-[11px] font-mono text-pink-300/70 tracking-widest uppercase">CORE // TOOLS</span>
          </div>

          <!-- Pills List (Kitsune Scroll Talisman Tag Pills) -->
          <div class="relative z-10 flex flex-wrap gap-2.5 sm:gap-3">
            {skills.map((skill) => (
              <TagPill tag={skill} size="lg" class="cursor-default select-none" />
            ))}
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
