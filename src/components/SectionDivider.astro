---
// ──────────────────────────────────────────────────────────────────────────────
//  SectionDivider.astro — Grand Narukami Shrine Thematic Section Dividers
// ──────────────────────────────────────────────────────────────────────────────
//  Provides 4 distinct, handcrafted visual dividers between sections:
//    1. "torii-arc"         (Hero ➔ Projects)     : Curved neon arc with Torii gate crest & guide arrows
//    2. "mizuhiki-sakura"   (Projects ➔ About Me) : Japanese Mizuhiki woven cords with watercolor Sakura medal
//    3. "shimenawa-kitsune" (About Me ➔ Contact)  : Sacred Shimenawa rope line with Inazuma Shide & Kitsune seal
//    4. "kasumi-wave"       (Contact ➔ Footer)    : Ethereal Kasumi cloud wave with twin Sakura petals & Torii gate
// ──────────────────────────────────────────────────────────────────────────────
import { Image } from 'astro:assets';
import sakuraIcon from '../assets/images/sakura-flower.webp';
import toriGateImg from '../assets/images/tori-gate.png';
import kitsuneIcon from '../assets/images/kitsune-icon.png';

interface Props {
  variant: 'torii-arc' | 'mizuhiki-sakura' | 'shimenawa-kitsune' | 'kasumi-wave';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

<style is:global>
  @keyframes crestGlow {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 6px rgba(244, 114, 182, 0.16)); }
    50% { transform: scale(1.02); filter: drop-shadow(0 0 12px rgba(244, 114, 182, 0.3)); }
  }
  .animate-crest-glow {
    animation: crestGlow 4s ease-in-out infinite;
  }
</style>

<div class={`relative z-10 w-full flex items-center justify-center select-none pointer-events-none py-6 sm:py-10 overflow-hidden ${className}`} aria-hidden="true">
  {variant === 'torii-arc' && (
    <div class="w-full max-w-2xl px-4 flex flex-col items-center justify-center">
      <div class="w-full relative flex items-center justify-center">
        <svg class="w-full h-8 text-pink-400/40" viewBox="0 0 440 24" fill="none">
          <path d="M 0,2 C 130,2 190,20 220,20 C 250,20 310,2 440,2" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" stroke-opacity="0.3" />
          <path d="M 70,2 C 150,2 195,18 220,18 C 245,18 290,2 370,2" stroke="url(#toriiArcGlow)" stroke-width="1.5" />
          <defs>
            <linearGradient id="toriiArcGlow" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#f472b6" stop-opacity="0" />
              <stop offset="50%" stop-color="#f472b6" stop-opacity="0.9" />
              <stop offset="100%" stop-color="#f472b6" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <div class="absolute -bottom-3 flex flex-col items-center justify-center">
          <div class="animate-crest-glow relative p-1 rounded-full bg-[#0c0b16]/90 border border-pink-400/30 backdrop-blur-md shadow-[0_0_12px_rgba(244,114,182,0.3)]">
            <Image src={toriGateImg} width={20} height={20} alt="" class="w-4 h-4 object-contain" decoding="async" />
          </div>
          <svg class="section-divider-bounce w-3.5 h-3.5 text-pink-300 animate-bounce mt-1.5 opacity-80" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
          </svg>
        </div>
      </div>
    </div>
  )}

  {variant === 'mizuhiki-sakura' && (
    <div class="w-full max-w-4xl px-4 flex items-center justify-center gap-3 sm:gap-4">
      <div class="flex-1 flex items-center justify-end">
        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-pink-500/40 to-pink-400/80"></div>
        <div class="h-2 w-2 rotate-45 border border-pink-400/70 bg-[#0c0b16] -ml-1 shrink-0 shadow-[0_0_8px_rgba(244,114,182,0.4)]"></div>
        <div class="w-3 sm:w-8 h-[1px] bg-pink-400/80"></div>
      </div>

      <div class="animate-crest-glow liquid-glass-control shrink-0 flex items-center gap-2 sm:gap-3 px-3 py-1.5 rounded-full shadow-[0_0_16px_rgba(244,114,182,0.25)]">
        <span class="text-pink-400 text-[10px] sm:text-xs select-none drop-shadow-[0_0_4px_rgba(244,114,182,0.8)]">✦</span>
        <div class="w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center">
          <Image src={sakuraIcon} width={24} height={24} alt="" class="w-4 h-4 sm:w-5 sm:h-5 object-contain" decoding="async"  densities={[1.5, 2, 3]} />
        </div>
        <span class="text-[11px] sm:text-xs font-serif text-pink-200/90 tracking-widest uppercase hidden md:inline">八重の桜</span>
        <span class="text-pink-400 text-[10px] sm:text-xs select-none drop-shadow-[0_0_4px_rgba(244,114,182,0.8)]">✦</span>
      </div>

      <div class="flex-1 flex items-center justify-start">
        <div class="w-3 sm:w-8 h-[1px] bg-pink-400/80"></div>
        <div class="h-2 w-2 rotate-45 border border-pink-400/70 bg-[#0c0b16] -mr-1 shrink-0 shadow-[0_0_8px_rgba(244,114,182,0.4)]"></div>
        <div class="w-full h-[1px] bg-gradient-to-l from-transparent via-pink-500/40 to-pink-400/80"></div>
      </div>
    </div>
  )}

  {variant === 'shimenawa-kitsune' && (
    <div class="w-full max-w-4xl px-4 flex items-center justify-center gap-3 sm:gap-5">
      <div class="flex-1 flex items-center justify-end relative">
        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-purple-500/30 to-pink-400/70"></div>
        <svg class="w-6 sm:w-10 h-3 text-pink-400/70 shrink-0 ml-1" viewBox="0 0 32 10" fill="none">
          <path d="M0,5 L8,1 L16,9 L24,1 L32,5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        </svg>
      </div>

      <div class="animate-crest-glow liquid-glass-control shrink-0 flex items-center gap-2 sm:gap-2.5 px-3 sm:px-4 py-1.5 rounded-2xl shadow-[0_0_18px_rgba(236,72,153,0.2)]">
        <span class="text-pink-400 text-xs">❖</span>
        <div class="w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center">
          <Image src={kitsuneIcon} width={24} height={24} alt="" class="w-5 h-5 sm:w-6 sm:h-6 object-contain filter brightness-110" decoding="async" />
        </div>
        <span class="text-xs font-serif text-pink-300/90 tracking-wider">狐の社</span>
        <span class="text-pink-400 text-xs">❖</span>
      </div>

      <div class="flex-1 flex items-center justify-start relative">
        <svg class="w-6 sm:w-10 h-3 text-pink-400/70 shrink-0 mr-1 rotate-180" viewBox="0 0 32 10" fill="none">
          <path d="M0,5 L8,1 L16,9 L24,1 L32,5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        </svg>
        <div class="w-full h-[1px] bg-gradient-to-l from-transparent via-purple-500/30 to-pink-400/70"></div>
      </div>
    </div>
  )}

  {variant === 'kasumi-wave' && (
    <div class="w-full max-w-3xl px-4 flex flex-col items-center justify-center">
      <div class="w-full relative flex items-center justify-center">
        <svg class="w-full h-7 text-pink-400/40" viewBox="0 0 480 20" fill="none">
          <path d="M 0,10 C 80,10 120,2 180,2 C 220,2 240,16 280,16 C 340,16 380,6 480,6" stroke="url(#kasumiGradient)" stroke-width="1.2" />
          <path d="M 40,14 C 110,14 160,6 200,6 C 240,6 270,18 310,18 C 370,18 420,10 460,10" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 4" stroke-opacity="0.3" />
          <defs>
            <linearGradient id="kasumiGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#f472b6" stop-opacity="0" />
              <stop offset="30%" stop-color="#f472b6" stop-opacity="0.8" />
              <stop offset="70%" stop-color="#fb7185" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#f472b6" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <div class="absolute -bottom-2.5 flex items-center gap-3 bg-[#0c0b16]/90 px-3.5 py-1 rounded-full border border-pink-400/25 backdrop-blur-md shadow-[0_0_14px_rgba(244,114,182,0.2)]">
          <Image src={sakuraIcon} width={14} height={14} alt="" class="w-3 h-3 object-contain opacity-75" decoding="async"  densities={[1.5, 2, 3]} />
          <Image src={toriGateImg} width={18} height={18} alt="" class="w-3.5 h-3.5 object-contain" decoding="async" />
          <Image src={sakuraIcon} width={14} height={14} alt="" class="w-3 h-3 object-contain opacity-75" decoding="async"  densities={[1.5, 2, 3]} />
        </div>
      </div>
    </div>
  )}
</div>
