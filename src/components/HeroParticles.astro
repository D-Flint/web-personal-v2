<div class="hero-pixel-field" data-hero-field>
  <div class="hero-pixel-fallback" aria-hidden="true">OBSERVE</div>
  <canvas id="hero-particles" aria-hidden="true"> </canvas>
  <div class="hero-field-caption">
    <span id="hero-field-note">Observe — Study how the system behaves</span>
    <span id="hero-field-step" class="technical"> 01 / 05 </span>
  </div>
</div>
<script>
  // The hero cycles through five words. Each word is rasterized into target dots.
  // Read in order: scene state → transition setup → frame loop → word sampling → input.
  const canvas = document.querySelector<HTMLCanvasElement>('#hero-particles')!;
  const noteEl = document.querySelector<HTMLElement>('#hero-field-note');
  const stepEl = document.querySelector<HTMLElement>('#hero-field-step');
  const ctx = canvas.getContext('2d');
  if (ctx) {
    // 1. State: assemble moves dots into a word, hold makes it readable, scatter disperses it.
    // x/y are current positions; sx/sy are the starting positions of a transition.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const words = ['OBSERVE', 'DISSECT', 'DRAFT', 'TEMPER', 'CRAFT'];
    const notes = [
      'Observe — Study how the system behaves',
      'Dissect — Take the mechanism apart',
      'Draft — Map the architecture from within',
      'Temper — Stress-test every edge and seam',
      'Craft — Shape fast, deliberate software',
    ];
    type Target = { x: number; y: number };
    type Point = Target & { sx: number; sy: number; vx: number; vy: number };
    let points: Point[] = [],
      targets: Target[][] = [],
      width = 0,
      height = 0,
      frame = 0,
      lastFrameTime = 0,
      visible = true,
      ready = false;
    let word = 0,
      phase: 'assemble' | 'scatter' | 'hold' = 'assemble',
      elapsed = 0,
      hold = 0,
      next = 0;
    const pointer = { x: 0, y: 0, active: false };
    const canAnimate = () => ready && visible && !document.hidden && !reduce.matches;
    const clamp = (v: number, max: number) =>
      Math.max(particleSize / 2, Math.min(max - particleSize / 2, v));
    const randomCanvasPosition = () => ({
      x: particleSize / 2 + Math.random() * (width - particleSize),
      y: particleSize / 2 + Math.random() * (height - particleSize),
    });
    function updateWordCaption() {
      if (noteEl) noteEl.textContent = notes[word];
      if (stepEl) stepEl.textContent = `0${word + 1} / 0${words.length}`;
    }
    // Render one frame and keep the written caption synchronized with the current word.
    function renderWord() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = getComputedStyle(document.documentElement)
        .getPropertyValue('--accent')
        .trim();
      for (const p of points) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, particleSize / 2, 0, Math.PI * 2);
        ctx!.fill();
      }
      canvas.dataset.word = words[word];
      canvas.dataset.phase = phase;
      updateWordCaption();
    }
    document.addEventListener('theme-change', () => {
      if (ready) renderWord();
    });
    // Snapshot current positions so interrupted transitions start without a visual jump.
    function startWordTransition(index: number, shouldScatter = false) {
      next = index;
      elapsed = 0;
      hold = 0;
      phase = shouldScatter ? 'scatter' : 'assemble';
      if (!shouldScatter) {
        word = index;
        updateWordCaption();
      }
      points.forEach((p) => {
        p.sx = p.x;
        p.sy = p.y;
        p.vx = p.vy = 0;
      });
      if (shouldScatter) destinations = points.map(randomCanvasPosition);
      updateAnimationPlayback();
    }
    let destinations: Target[] = [];
    let particleSize = 2;
    // 2. Advance the current phase using elapsed milliseconds. During a readable hold,
    // dots use a spring to return after pointer repulsion; transitions use cubic easing.
    function animateWordFrame(time: number) {
      frame = 0;
      if (!canAnimate()) return;
      const frameElapsedMs = Math.max(0, time - lastFrameTime);
      lastFrameTime = time;
      if (phase !== 'hold') {
        elapsed += frameElapsedMs;
        const duration = phase === 'scatter' ? 1400 : 3000;
        const t = Math.min(1, elapsed / duration),
          ease = 1 - Math.pow(1 - t, 3);
        const ends = phase === 'scatter' ? destinations : targets[word];
        points.forEach((p, i) => {
          p.x = p.sx + (ends[i].x - p.sx) * ease;
          p.y = p.sy + (ends[i].y - p.sy) * ease;
        });
        if (t === 1) {
          if (phase === 'scatter') startWordTransition(next);
          else {
            phase = 'hold';
            hold = 0;
          }
        }
      } else {
        hold += frameElapsedMs;
        const dt = Math.min(2, frameElapsedMs / 16.67);
        points.forEach((p, i) => {
          const target = targets[word][i],
            dx = p.x - pointer.x,
            dy = p.y - pointer.y,
            d = Math.hypot(dx, dy);
          if (pointer.active && d < 95) {
            const force = (1 - d / 95) * 0.9;
            p.vx += (dx / (d || 1)) * force * dt;
            p.vy += (dy / (d || 1)) * force * dt;
          }
          p.vx = (p.vx + (target.x - p.x) * 0.018 * dt) * Math.pow(0.84, dt);
          p.vy = (p.vy + (target.y - p.y) * 0.018 * dt) * Math.pow(0.84, dt);
          p.x = clamp(p.x + p.vx * dt, width);
          p.y = clamp(p.y + p.vy * dt, height);
        });
        if (hold >= 5000) startWordTransition((word + 1) % words.length, true);
      }
      renderWord();
      if (!frame) frame = requestAnimationFrame(animateWordFrame);
      canvas.dataset.animating = 'true';
    }
    // Schedule exactly one frame, or cancel it when hidden, offscreen, or motion is reduced.
    function updateAnimationPlayback() {
      canvas.dataset.running = String(canAnimate());
      if (canAnimate() && !frame) {
        lastFrameTime = performance.now();
        frame = requestAnimationFrame(animateWordFrame);
      } else if (!canAnimate()) {
        cancelAnimationFrame(frame);
        frame = 0;
        canvas.dataset.animating = 'false';
      }
    }
    // Render words into alpha masks on an offscreen canvas. The visible canvas
    // only draws dots; this temporary canvas tells us which pixel cells contain ink.
    function rasterizeWordMasks(mask: HTMLCanvasElement, ink: CanvasRenderingContext2D) {
      return words.map((text) => {
        ink.clearRect(0, 0, mask.width, mask.height);
        let size = Math.min(width * 0.3, height * 0.8);
        ink.font = `400 ${size}px Journal, serif`;
        const measure = ink.measureText(text);
        size *= Math.min(
          1,
          (width * 0.9) / measure.width,
          (height * 0.85) / (measure.actualBoundingBoxAscent + measure.actualBoundingBoxDescent),
        );
        ink.font = `400 ${size}px Journal, serif`;
        ink.textAlign = 'center';
        ink.textBaseline = 'alphabetic';
        const metrics = ink.measureText(text);
        ink.fillText(
          text,
          width / 2,
          (height + metrics.actualBoundingBoxAscent - metrics.actualBoundingBoxDescent) / 2,
        );
        return ink.getImageData(0, 0, mask.width, mask.height).data;
      });
    }
    // 3. Convert the loaded font into alpha masks, then sample dots on a shared grid.
    // Every word gets the same number of particles so transitions can pair dots by index.
    // Rasterize words on a shared pixel grid, then rebuild targets for the current viewport.
    function rebuildWordTargets() {
      if (!ready) return;
      const rect = canvas.getBoundingClientRect(),
        oldWidth = width,
        oldHeight = height;
      width = rect.width;
      height = rect.height;
      if (!width || !height) return;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const mask = document.createElement('canvas');
      mask.width = Math.ceil(width);
      mask.height = Math.ceil(height);
      const ink = mask.getContext('2d')!;
      const masks = rasterizeWordMasks(mask, ink);
      // Fit a complete lattice to the budget rather than dropping cells from
      // dense strokes, which created irregular missing-particle holes.
      const budget = points.length || 3200;
      let gap = width < 700 ? 3 : 5,
        samples: Target[][] = [];
      do {
        samples = masks.map((pixels) => {
          const result: Target[] = [];
          for (let y = gap; y < mask.height - gap; y += gap)
            for (let x = gap; x < mask.width - gap; x += gap)
              if (pixels[(y * mask.width + x) * 4 + 3] > 140) result.push({ x, y });
          return result;
        });
        if (samples.every((s) => s.length <= budget)) break;
        gap++;
      } while (gap < Math.min(width, height));
      particleSize = gap * 0.68;
      const count = points.length || Math.min(3200, Math.max(...samples.map((s) => s.length)));
      targets = samples.map((s) =>
        Array.from(
          { length: count },
          (_, i) => s[Math.floor((i * s.length) / count)] || { x: width / 2, y: height / 2 },
        ),
      );
      if (!points.length) {
        points = Array.from({ length: count }, () => ({
          ...randomCanvasPosition(),
          sx: 0,
          sy: 0,
          vx: 0,
          vy: 0,
        }));
        startWordTransition(0);
      } else {
        points.forEach((p) => {
          p.x *= width / oldWidth;
          p.y *= height / oldHeight;
          p.sx *= width / oldWidth;
          p.sy *= height / oldHeight;
        });
        destinations = destinations.map((p) => ({
          x: (p.x * width) / oldWidth,
          y: (p.y * height) / oldHeight,
        }));
      }
      if (reduce.matches) showStaticWord();
      canvas.dataset.points = String(points.length);
      canvas.dataset.ready = 'true';
      renderWord();
      updateAnimationPlayback();
    }
    // Reduced motion displays the first complete word without cycling or pointer movement.
    function showStaticWord() {
      word = 0;
      phase = 'hold';
      hold = 0;
      pointer.active = false;
      points.forEach((p, i) => {
        Object.assign(p, targets[0][i]);
        p.vx = p.vy = 0;
      });
    }
    function scatterCurrentWord() {
      if (!canAnimate()) return;
      pointer.active = false;
      startWordTransition(word, true);
    }
    // 4. Pointer and lifecycle hooks. Wait for fonts before measuring glyphs;
    // otherwise fallback-font targets would shift after the page loads.
    canvas.addEventListener('pointermove', (event) => {
      if (!canAnimate() || event.pointerType === 'touch') return;
      const rect = canvas.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
      pointer.active = true;
    });
    canvas.addEventListener('pointerleave', () => {
      pointer.active = false;
    });
    canvas.addEventListener('pointerdown', scatterCurrentWord, { passive: true });
    new ResizeObserver(rebuildWordTargets).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (!visible) pointer.active = false;
      updateAnimationPlayback();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      pointer.active = false;
      updateAnimationPlayback();
    });
    reduce.addEventListener('change', () => {
      if (reduce.matches) showStaticWord();
      renderWord();
      updateAnimationPlayback();
    });
    document.fonts.ready.then(() => {
      ready = true;
      rebuildWordTargets();
    });
  }
</script>
