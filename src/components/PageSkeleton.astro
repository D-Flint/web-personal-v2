---
interface Props {
  variant?: 'home' | 'projects' | 'fallback';
}

const { variant = 'fallback' } = Astro.props;
---

<div
  id="page-skeleton"
  class={`page-skeleton page-skeleton--${variant}`}
  role="status"
  aria-live="polite"
  aria-label="Loading page content"
>
  <span class="sr-only">Loading page content</span>
  <div class="skeleton-nav" aria-hidden="true">
    <span class="skeleton-mark"></span>
    <span class="skeleton-nav-name skeleton-shape"></span>
    <div class="skeleton-nav-links">
      <span class="skeleton-shape"></span>
      <span class="skeleton-shape"></span>
      <span class="skeleton-shape"></span>
      <span class="skeleton-shape"></span>
    </div>
    <span class="skeleton-nav-action skeleton-shape"></span>
  </div>

  {variant === 'home' && (
    <div class="skeleton-home" aria-hidden="true">
      <div class="skeleton-home-copy">
        <span class="skeleton-pill skeleton-shape"></span>
        <span class="skeleton-title skeleton-shape"></span>
        <span class="skeleton-title skeleton-title--accent skeleton-shape"></span>
        <span class="skeleton-subtitle skeleton-shape"></span>
        <span class="skeleton-line skeleton-shape"></span>
        <span class="skeleton-line skeleton-line--short skeleton-shape"></span>
        <div class="skeleton-actions">
          <span class="skeleton-shape"></span>
          <span class="skeleton-shape"></span>
          <span class="skeleton-shape"></span>
        </div>
      </div>
      <div class="skeleton-scenic-glow"></div>
    </div>
  )}

  {variant === 'projects' && (
    <div class="skeleton-projects" aria-hidden="true">
      <span class="skeleton-kicker skeleton-shape"></span>
      <span class="skeleton-project-title skeleton-shape"></span>
      <span class="skeleton-project-copy skeleton-shape"></span>
      <div class="skeleton-stats">
        <span class="skeleton-shape"></span>
        <span class="skeleton-shape"></span>
        <span class="skeleton-shape"></span>
      </div>
      <div class="skeleton-filters">
        <span class="skeleton-search skeleton-shape"></span>
        <span class="skeleton-filter-action skeleton-shape"></span>
        <div class="skeleton-filter-pills">
          <span class="skeleton-shape"></span>
          <span class="skeleton-shape"></span>
          <span class="skeleton-shape"></span>
          <span class="skeleton-shape"></span>
        </div>
      </div>
      <div class="skeleton-cards">
        {[0, 1, 2].map(() => (
          <div class="skeleton-card">
            <span class="skeleton-card-media skeleton-shape"></span>
            <div class="skeleton-card-meta">
              <span class="skeleton-card-icon skeleton-shape"></span>
              <span class="skeleton-card-label skeleton-shape"></span>
            </div>
            <span class="skeleton-card-title skeleton-shape"></span>
            <span class="skeleton-card-copy skeleton-shape"></span>
            <div class="skeleton-card-tags">
              <span class="skeleton-shape"></span>
              <span class="skeleton-shape"></span>
              <span class="skeleton-shape"></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {variant === 'fallback' && (
    <div class="skeleton-fallback" aria-hidden="true">
      <span class="skeleton-fallback-seal"></span>
      <span class="skeleton-fallback-code skeleton-shape"></span>
      <span class="skeleton-fallback-title skeleton-shape"></span>
      <span class="skeleton-fallback-line skeleton-shape"></span>
      <span class="skeleton-fallback-line skeleton-fallback-line--short skeleton-shape"></span>
      <div class="skeleton-fallback-divider"></div>
      <div class="skeleton-fallback-actions">
        <span class="skeleton-shape"></span>
        <span class="skeleton-shape"></span>
      </div>
    </div>
  )}
</div>

<noscript><style>#page-skeleton{display:none!important}html,body{overflow:auto!important}</style></noscript>

<script is:inline>
  (function () {
    var skeleton = document.getElementById('page-skeleton');
    if (!skeleton) return;

    document.documentElement.classList.add('page-is-loading');

    var released = false;
    var assetsReady = false;
    var matrixReady = !document.getElementById('matrix-splash');
    var safetyTimer;
    var removalTimer;
    var root;
    var previousInert = false;
    var previousBusy = null;
    var previousFocus = document.activeElement;
    var scrollX = window.scrollX;
    var scrollY = window.scrollY;
    var imageCleanups = [];
    var waitingForDom = false;

    function cleanupReadinessWork() {
      document.removeEventListener('matrix-splash-done', onMatrixReady);
      if (waitingForDom) {
        document.removeEventListener('DOMContentLoaded', beginReadinessCheck);
        waitingForDom = false;
      }
      imageCleanups.forEach(function (cleanup) { cleanup(); });
      imageCleanups = [];
    }

    function release() {
      if (released) return;
      released = true;
      if (safetyTimer) window.clearTimeout(safetyTimer);
      cleanupReadinessWork();

      document.documentElement.classList.remove('page-is-loading');
      document.documentElement.classList.add('page-is-ready');
      if (root) {
        root.inert = previousInert;
        if (previousBusy === null) root.removeAttribute('aria-busy');
        else root.setAttribute('aria-busy', previousBusy);
      }

      skeleton.classList.add('page-skeleton--leaving');
      document.dispatchEvent(new CustomEvent('page-content-ready'));
      window.scrollTo(scrollX, scrollY);

      if (previousFocus && previousFocus !== document.body && document.contains(previousFocus)) {
        try { previousFocus.focus({ preventScroll: true }); } catch (error) { /* focus target became unavailable */ }
      }

      removalTimer = window.setTimeout(function () {
        skeleton.remove();
        removalTimer = undefined;
      }, 440);
    }

    function maybeRelease() {
      if (matrixReady && assetsReady) release();
    }

    function onMatrixReady() {
      if (matrixReady) return;
      matrixReady = true;
      safetyTimer = window.setTimeout(release, 6000);
      maybeRelease();
    }

    document.addEventListener('matrix-splash-done', onMatrixReady, { once: true });
    if (matrixReady) safetyTimer = window.setTimeout(release, 6000);

    function settleImage(image) {
      if (image.complete) return Promise.resolve();
      return new Promise(function (resolve) {
        var settled = false;
        function cleanup() {
          image.removeEventListener('load', settle);
          image.removeEventListener('error', settle);
        }
        function settle() {
          if (settled) return;
          settled = true;
          cleanup();
          resolve();
        }
        imageCleanups.push(cleanup);
        image.addEventListener('load', settle, { once: true });
        image.addEventListener('error', settle, { once: true });
      });
    }

    function beginReadinessCheck() {
      waitingForDom = false;
      root = document.getElementById('page-content-root');
      if (root) {
        previousInert = root.inert;
        previousBusy = root.getAttribute('aria-busy');
        root.inert = true;
        root.setAttribute('aria-busy', 'true');
      }

      var criticalImages = Array.from(document.querySelectorAll('img[data-loading-critical]')).filter(function (image) {
        var rect = image.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0 && rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
      });
      var imageReadiness = Promise.all(criticalImages.map(settleImage));
      var fontReadiness = document.fonts && document.fonts.ready ? document.fonts.ready.catch(function () {}) : Promise.resolve();

      Promise.all([imageReadiness, fontReadiness]).then(function () {
        if (released) return;
        assetsReady = true;
        maybeRelease();
      });
    }

    if (document.readyState === 'loading') {
      waitingForDom = true;
      document.addEventListener('DOMContentLoaded', beginReadinessCheck, { once: true });
    } else {
      beginReadinessCheck();
    }
  })();
</script>

<style is:global>
  html.page-is-loading,
  html.page-is-loading body {
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  .page-skeleton {
    --skeleton-bg: #090810;
    --skeleton-surface: rgba(24, 20, 35, 0.58);
    --skeleton-surface-soft: rgba(37, 27, 43, 0.46);
    --skeleton-rim: rgba(244, 114, 182, 0.075);
    --skeleton-highlight: rgba(244, 180, 211, 0.065);
    position: fixed;
    inset: 0;
    z-index: 9999;
    overflow: hidden;
    color-scheme: dark;
    background:
      radial-gradient(circle at 78% 28%, rgba(116, 61, 112, 0.14), transparent 36%),
      radial-gradient(circle at 18% 76%, rgba(190, 65, 122, 0.065), transparent 32%),
      var(--skeleton-bg);
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms ease, visibility 400ms step-end;
  }

  .page-skeleton::after {
    content: '';
    position: absolute;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    transform: translateX(-115%);
    background: linear-gradient(100deg, transparent 36%, var(--skeleton-highlight) 50%, transparent 64%);
    animation: skeleton-shimmer 1.8s ease-in-out infinite;
  }

  .page-skeleton--leaving {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .skeleton-nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(calc(100% - 2rem), 80rem);
    height: 4.25rem;
    margin: 0.75rem auto 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--skeleton-rim);
    border-radius: 1.5rem;
    background: rgba(10, 9, 18, 0.52);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
  }

  .skeleton-mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 1px solid var(--skeleton-rim);
    border-radius: 45% 45% 38% 38%;
    background: var(--skeleton-surface-soft);
  }

  .skeleton-shape {
    position: relative;
    display: block;
    border: 1px solid var(--skeleton-rim);
    background: linear-gradient(115deg, var(--skeleton-surface), var(--skeleton-surface-soft));
  }

  .skeleton-nav-name { width: 8.5rem; height: 0.8rem; border-radius: 999px; }
  .skeleton-nav-links { display: flex; gap: 1.8rem; margin-left: auto; }
  .skeleton-nav-links span { width: 3.4rem; height: 0.65rem; border-radius: 999px; }
  .skeleton-nav-action { width: 6rem; height: 2rem; border-radius: 999px; }

  .skeleton-home,
  .skeleton-projects {
    position: relative;
    width: min(calc(100% - 2rem), 80rem);
    height: calc(100dvh - 6rem);
    margin: 0 auto;
  }

  .skeleton-home-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(42rem, 58vw);
    height: 88%;
    padding-top: 1.5rem;
    gap: clamp(1rem, 2.2vh, 2rem);
  }

  .skeleton-pill { width: 19rem; height: 1.8rem; border-radius: 999px; }
  .skeleton-title { width: min(18rem, 54vw); height: clamp(2.5rem, 5.2vw, 4.45rem); border-radius: 0.7rem; }
  .skeleton-title--accent { width: min(28rem, 66vw); margin-top: calc(clamp(1rem, 2.2vh, 2rem) * -0.72); }
  .skeleton-subtitle { width: min(34rem, 75vw); height: 3.4rem; border-radius: 0.55rem; }
  .skeleton-line { width: min(36rem, 78vw); height: 0.8rem; border-radius: 999px; }
  .skeleton-line--short { width: min(27rem, 62vw); }
  .skeleton-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.25rem; }
  .skeleton-actions span { height: 2.75rem; border-radius: 0.75rem; }
  .skeleton-actions span:nth-child(1) { width: 9.5rem; }
  .skeleton-actions span:nth-child(2) { width: 8.6rem; }
  .skeleton-actions span:nth-child(3) { width: 7.4rem; }
  .skeleton-scenic-glow {
    position: absolute;
    top: 8%;
    right: -4%;
    width: min(45vw, 38rem);
    aspect-ratio: 0.9;
    border-radius: 58% 42% 62% 38% / 42% 58% 44% 56%;
    background:
      radial-gradient(ellipse at 58% 31%, rgba(181, 93, 155, 0.16), transparent 35%),
      radial-gradient(ellipse at 44% 62%, rgba(68, 46, 81, 0.18), transparent 55%);
    filter: blur(7px);
    opacity: 0.82;
  }

  .skeleton-projects { padding-top: 3.25rem; }
  .skeleton-kicker { width: 12rem; height: 0.7rem; border-radius: 999px; }
  .skeleton-project-title { width: min(34rem, 74vw); height: clamp(2.8rem, 5vw, 4.4rem); margin-top: 0.8rem; border-radius: 0.8rem; }
  .skeleton-project-copy { width: min(39rem, 85vw); height: 0.9rem; margin-top: 1rem; border-radius: 999px; }
  .skeleton-stats { display: flex; gap: 0.65rem; margin-top: 1.2rem; }
  .skeleton-stats span { width: 8.5rem; height: 1.7rem; border-radius: 999px; }
  .skeleton-filters { margin-top: 2.5rem; min-height: 10.5rem; padding: 1.2rem; border: 1px solid var(--skeleton-rim); border-radius: 1rem; background: rgba(13, 11, 23, 0.48); }
  .skeleton-search { width: 76%; height: 2.6rem; border-radius: 0.7rem; }
  .skeleton-filter-action { width: 18%; height: 2.6rem; margin: -2.6rem 0 0 auto; border-radius: 0.7rem; }
  .skeleton-filter-pills { display: flex; gap: 0.6rem; margin-top: 1rem; }
  .skeleton-filter-pills span { width: 6rem; height: 1.55rem; border-radius: 999px; }
  .skeleton-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; }
  .skeleton-card { min-width: 0; height: 23rem; padding: 0.8rem; border: 1px solid var(--skeleton-rim); border-radius: 1.125rem; background: rgba(12, 11, 22, 0.28); }
  .skeleton-card-media { width: 100%; aspect-ratio: 16 / 10; border-radius: 0.75rem; }
  .skeleton-card-meta { display: flex; align-items: center; gap: 0.65rem; margin-top: 0.9rem; }
  .skeleton-card-icon { width: 2.25rem; height: 2.25rem; flex: none; border-radius: 0.55rem; }
  .skeleton-card-label { width: 5.25rem; height: 0.55rem; border-radius: 999px; }
  .skeleton-card-title { width: 72%; height: 1.2rem; margin-top: 0.85rem; border-radius: 0.4rem; }
  .skeleton-card-copy { width: 94%; height: 0.65rem; margin-top: 0.65rem; border-radius: 999px; }
  .skeleton-card-tags { display: flex; gap: 0.4rem; margin-top: 1rem; }
  .skeleton-card-tags span { width: 3.6rem; height: 1.1rem; border-radius: 999px; }

  .skeleton-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100dvh - 6rem);
    gap: 0.85rem;
  }
  .skeleton-fallback-seal { width: 4.5rem; height: 4.5rem; border-radius: 38%; background: radial-gradient(circle, rgba(181, 93, 155, 0.14), transparent 72%); }
  .skeleton-fallback-code { width: min(16rem, 58vw); height: clamp(5.8rem, 12vw, 8rem); border-radius: 1rem; }
  .skeleton-fallback-title { width: min(24rem, 72vw); height: 1.45rem; border-radius: 0.55rem; }
  .skeleton-fallback-line { width: min(32rem, 82vw); height: 0.85rem; border-radius: 999px; }
  .skeleton-fallback-line--short { width: min(24rem, 68vw); }
  .skeleton-fallback-divider { width: 7rem; height: 1px; margin: 0.7rem 0; background: rgba(244, 114, 182, 0.12); }
  .skeleton-fallback-actions { display: flex; gap: 1rem; }
  .skeleton-fallback-actions span { width: 11rem; height: 2.75rem; border-radius: 999px; }

  @keyframes skeleton-shimmer {
    0%, 18% { transform: translateX(-110%); }
    72%, 100% { transform: translateX(110%); }
  }

  @media (max-width: 767px) {
    .skeleton-nav { height: 3.75rem; margin-top: 0.5rem; border-radius: 1rem; }
    .skeleton-mark { width: 2.15rem; height: 2.15rem; }
    .skeleton-nav-name { width: 6.5rem; }
    .skeleton-nav-links { display: none; }
    .skeleton-nav-action { width: 2.2rem; margin-left: auto; }
    .skeleton-home-copy { width: 100%; height: 82%; padding-top: 2rem; gap: 1.15rem; }
    .skeleton-pill { width: min(19rem, 88vw); }
    .skeleton-title { height: 3rem; }
    .skeleton-title--accent { margin-top: -0.85rem; }
    .skeleton-subtitle { height: 3.1rem; }
    .skeleton-actions { width: 100%; gap: 0.75rem; }
    .skeleton-actions span:nth-child(1) { width: 46%; }
    .skeleton-actions span:nth-child(2) { width: 41%; }
    .skeleton-actions span:nth-child(3) { width: 32%; }
    .skeleton-scenic-glow { right: -42%; top: 8%; width: 90vw; opacity: 0.38; }
    .skeleton-projects { padding-top: 2.4rem; }
    .skeleton-project-copy { height: 2.2rem; border-radius: 0.55rem; }
    .skeleton-stats span { width: 5.8rem; }
    .skeleton-filters { margin-top: 1.7rem; min-height: 9rem; }
    .skeleton-search { width: 100%; }
    .skeleton-filter-action { display: none; }
    .skeleton-filter-pills { overflow: hidden; }
    .skeleton-filter-pills span { min-width: 5.5rem; }
    .skeleton-cards { grid-template-columns: 1fr; margin-top: 1.5rem; }
    .skeleton-card { height: 18rem; }
    .skeleton-card:nth-child(n + 2) { display: none; }
    .skeleton-fallback-actions { width: min(22rem, calc(100% - 2rem)); flex-direction: column; }
    .skeleton-fallback-actions span { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-skeleton::after { animation: none; display: none; }
    .page-skeleton { transition-duration: 0.01ms; }
  }

  html:not(.dark) .page-skeleton {
    --skeleton-bg: #f8f2f6;
    --skeleton-surface: rgba(114, 84, 105, 0.11);
    --skeleton-surface-soft: rgba(142, 96, 124, 0.08);
    --skeleton-rim: rgba(157, 78, 120, 0.07);
    --skeleton-highlight: rgba(255, 255, 255, 0.18);
    color-scheme: light;
    background:
      radial-gradient(circle at 78% 28%, rgba(188, 120, 165, 0.1), transparent 36%),
      radial-gradient(circle at 18% 76%, rgba(221, 153, 181, 0.08), transparent 32%),
      var(--skeleton-bg);
  }

  html:not(.dark) .skeleton-nav,
  html:not(.dark) .skeleton-filters,
  html:not(.dark) .skeleton-card {
    background: rgba(255, 250, 253, 0.42);
    box-shadow: 0 16px 40px rgba(83, 52, 72, 0.06);
  }
</style>
