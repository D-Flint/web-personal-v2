<!-- Launcher stays outside the panel so it can receive focus again after closing. -->
<button
  class="button assistant-launcher"
  id="assistant-open"
  aria-haspopup="dialog"
  aria-controls="neko-chat"
  aria-label="Ask about my work"
  title="Ask about my work"
>
  <svg
    class="arrow"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M4 4h16v12H9l-5 4V4zM8 8h8m-8 4h5"></path>
  </svg>
  <span class="sr-only">Ask about my work</span>
</button>
<!-- Keep the inner flex wrapper: Astro 7 script preservation and chat overflow depend on it. -->
<dialog id="neko-chat" class="assistant-dialog" aria-labelledby="assistant-title">
  <div class="flex h-full min-h-0 flex-col overflow-hidden assistant-shell">
    <!-- Header and composer stay visible while conversation controls scroll together. -->
    <div class="assistant-header">
      <div>
        <h2 id="assistant-title">Portfolio assistant</h2>
        <p>Ask about Hoeurb’s work and experience.</p>
      </div>
      <button id="assistant-close" class="icon-button" aria-label="Close assistant">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M6 18 18 6"></path>
        </svg>
      </button>
    </div>
    <div class="assistant-content" id="assistant-content">
      <div
        id="chat-log"
        class="chat-log"
        role="log"
        aria-label="Conversation"
        aria-live="polite"
        aria-relevant="additions text"
      >
        <div class="chat-message">
          <strong>Assistant</strong>What would you like to know about Hoeurb’s projects, skills, or
          background?
        </div>
      </div>
      <div class="chat-prompts">
        <button data-prompt="Tell me about your AI assistant project.">AI assistant</button>
        <button data-prompt="What are your technical skills?"> Technical skills </button>
        <button data-prompt="How can I contact Hoeurb?">Contact</button>
      </div>
      <p class="chat-status" id="chat-status" role="status"></p>
      <button class="button secondary chat-retry" id="chat-retry" hidden> Retry message </button>
    </div>
    <form class="chat-form" id="chat-form">
      <label for="chat-input">
        <span>Your question · up to 250 characters</span>
        <textarea id="chat-input" maxlength="250" required rows="2" placeholder="Ask a question…"></textarea>
      </label>
      <button class="button" id="chat-send" type="submit">Send</button>
    </form>
    <button class="chat-reset" id="chat-reset">Clear conversation</button>
  </div>
</dialog>
<script>
  // This component is a non-modal chat panel: visitors can keep scrolling the page.
  // Flow: submit a question → stream text into one bubble → save the completed exchange.
  // Failed requests remove their partial answer and keep the question available for retry.

  // 1. Connect the controls to their markup and keep conversation state in memory.
  type ChatMessage = { role: 'user' | 'assistant'; content: string };
  const dialog = document.querySelector<HTMLDialogElement>('#neko-chat')!;
  const input = document.querySelector<HTMLTextAreaElement>('#chat-input')!;
  const log = document.querySelector<HTMLElement>('#chat-log')!;
  const scrollRegion = document.querySelector<HTMLElement>('#assistant-content')!;
  const status = document.querySelector<HTMLElement>('#chat-status')!;
  const sendButton = document.querySelector<HTMLButtonElement>('#chat-send')!;
  const retryButton = document.querySelector<HTMLButtonElement>('#chat-retry')!;
  const resetButton = document.querySelector<HTMLButtonElement>('#chat-reset')!;
  const launcher = document.querySelector<HTMLButtonElement>('#assistant-open')!;
  const promptButtons = document.querySelectorAll<HTMLButtonElement>('[data-prompt]');
  const compactViewportHeight = 440;
  let conversationHistory: ChatMessage[] = [];
  let failedQuestion = '';

  // 2. Manage panel visibility, focus, and the space left by the mobile keyboard.
  function fitPanelToViewport() {
    if (!dialog.open) return;
    const viewport = window.visualViewport;
    if (!viewport) return;

    dialog.toggleAttribute('data-compact', viewport.height < compactViewportHeight);
    dialog.style.maxHeight = `${viewport.height - 24}px`;
    dialog.style.bottom = `${Math.max(12, window.innerHeight - viewport.height - viewport.offsetTop + 12)}px`;
  }

  launcher.setAttribute('aria-controls', 'neko-chat');
  launcher.setAttribute('aria-expanded', 'false');
  launcher.addEventListener('click', () => {
    if (dialog.open) return;
    dialog.show();
    launcher.setAttribute('aria-expanded', 'true');
    fitPanelToViewport();
    input.focus({ preventScroll: true });
  });
  document.querySelector('#assistant-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    launcher.setAttribute('aria-expanded', 'false');
    launcher.focus({ preventScroll: true });
  });
  document.addEventListener('keydown', (event) => {
    // A project modal takes priority over this panel when both are open.
    if (event.key === 'Escape' && dialog.open && !document.querySelector('dialog:modal')) {
      event.preventDefault();
      dialog.close();
    }
  });
  window.visualViewport?.addEventListener('resize', fitPanelToViewport);
  window.visualViewport?.addEventListener('scroll', fitPanelToViewport);

  // 3. Render text safely and keep request-related controls in sync.
  function appendMessage(role: string, text: string) {
    const item = document.createElement('div');
    item.className = `chat-message ${role}`;
    const label = document.createElement('strong');
    label.textContent = role === 'user' ? 'You' : 'Assistant';
    const content = document.createElement('span');
    // Provider and visitor text must remain plain text, never executable HTML.
    content.textContent = text;
    item.append(label, content);
    log.append(item);
    scrollRegion.scrollTop = scrollRegion.scrollHeight;
    return { item, content };
  }

  function setRequestPending(pending: boolean) {
    sendButton.disabled = pending;
    resetButton.disabled = pending;
    input.disabled = pending;
    promptButtons.forEach((button) => {
      button.disabled = pending;
    });
    if (pending) log.setAttribute('aria-busy', 'true');
    else log.removeAttribute('aria-busy');
  }

  // 4. Read the response incrementally so the visitor sees text as it arrives.
  async function readReply(response: Response, content: HTMLElement) {
    if (!response.body) throw new Error('No response received. Please retry.');
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let reply = '';

    // The API already removes provider SSE envelopes. Its body contains text chunks.
    // Streaming decoding preserves characters whose UTF-8 bytes span two chunks.
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      reply += decoder.decode(value, { stream: true });
      content.textContent = reply;
      scrollRegion.scrollTop = scrollRegion.scrollHeight;
    }
    reply += decoder.decode();
    content.textContent = reply;
    if (!reply.trim()) throw new Error('The assistant returned an empty response. Please retry.');
    return reply;
  }

  // 5. Run one question from pending state through success or a retryable failure.
  async function askQuestion(question: string, isRetry = false) {
    if (sendButton.disabled || !question.trim()) return;
    question = question.trim().slice(0, 250);
    // Retry uses the original user bubble instead of adding the same question twice.
    if (!isRetry) appendMessage('user', question);
    failedQuestion = '';
    retryButton.hidden = true;
    setRequestPending(true);
    status.dataset.state = 'pending';
    status.textContent = 'Connecting to the assistant…';
    const answer = appendMessage('assistant', '');
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 45000);

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // Keep the request bounded; only completed exchanges enter this history.
        body: JSON.stringify({
          messages: [...conversationHistory.slice(-6), { role: 'user', content: question }],
        }),
        signal: controller.signal,
      });
      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        const errorMessage =
          response.status === 503
            ? 'Chat needs a server API key. You can still contact Hoeurb by email.'
            : data.error || 'The assistant couldn’t respond. Please retry.';
        throw new Error(errorMessage);
      }
      // Check the body before announcing streaming, matching the API error flow.
      if (!response.body) throw new Error('No response received. Please retry.');
      status.textContent = 'Assistant is responding…';
      const reply = await readReply(response, answer.content);
      conversationHistory.push(
        { role: 'user', content: question },
        { role: 'assistant', content: reply },
      );
      input.value = '';
      status.textContent = 'Response complete.';
      status.dataset.state = 'success';
    } catch (error) {
      // Discard partial replies: they must not become context for the next question.
      answer.item.remove();
      failedQuestion = question;
      status.textContent =
        error instanceof Error && error.name !== 'AbortError'
          ? error.message
          : 'The connection timed out. Please retry your message.';
      status.dataset.state = 'error';
      retryButton.hidden = false;
    } finally {
      clearTimeout(timeout);
      setRequestPending(false);
      scrollRegion.scrollTop = scrollRegion.scrollHeight;
      if (dialog.open) input.focus({ preventScroll: true });
    }
  }

  // 6. Route form, keyboard, suggestion, and retry actions through the same request flow.
  document.querySelector('#chat-form')!.addEventListener('submit', (event) => {
    event.preventDefault();
    askQuestion(input.value);
  });
  input.addEventListener('keydown', (event) => {
    // Shift+Enter keeps multiline editing; composing text must not submit mid-character.
    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
      event.preventDefault();
      askQuestion(input.value);
    }
  });
  retryButton.addEventListener('click', () => askQuestion(failedQuestion, true));
  promptButtons.forEach((button) =>
    button.addEventListener('click', () => askQuestion(button.dataset.prompt!)),
  );
  resetButton.addEventListener('click', () => {
    conversationHistory = [];
    failedQuestion = '';
    retryButton.hidden = true;
    log.replaceChildren();
    appendMessage('assistant', 'Conversation cleared. What would you like to know?');
    status.textContent = '';
    input.value = '';
    input.focus({ preventScroll: true });
  });
</script>
