---
import AssemblyFigure from './AssemblyFigure.astro';
import Arrow from './Arrow.astro';
import type { Project } from '../data/projects';
import type { ProjectPreview } from '../data/projectPreviews';
const { project, preview } = Astro.props as { project: Project; preview?: ProjectPreview };
---
<article class="project-assembly" data-project-assembly={project.num} aria-labelledby={`assembly-title-${project.num}`}>
  <a class="assembly-completion-link" href={`#assembly-complete-${project.num}`}>Project details<span class="sr-only">: {project.title}</span></a>
  <div class="assembly-stage" data-assembly-stage>
    <header class="assembly-introduction">
      <h3 id={`assembly-title-${project.num}`}>{project.title}</h3>
      <p>{project.description}</p>
    </header>
    {preview ? <AssemblyFigure preview={preview} title={project.title} /> : <p>Architecture preview unavailable. Read the project details in the catalog.</p>}
    <div class="assembly-completion" data-assembly-completion>
      <a class="text-link" href={preview?.cta.href || `/projects#project-${project.num}`} data-assembly-cta>
        {preview?.cta.label || `View ${project.title}`} <Arrow />
      </a>
    </div>
  </div>
  <span class="assembly-end" id={`assembly-complete-${project.num}`} tabindex="-1" aria-label={`${project.title} complete diagram`}></span>
  {preview && <script type="application/json" data-assembly-config set:html={JSON.stringify(preview).replace(/</g,'\\u003c')} />}
</article>
<script>
  import { initProjectAssemblies } from '../utils/assemblyController';
  // Astro bundles this script once, even though the component occurs three times.
  initProjectAssemblies();
</script>
