---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  mobileWidths?: number[];
  quality?: number;
  loading?: 'eager' | 'lazy';
  critical?: boolean;
}

const {
  desktop,
  mobile,
  mobileWidths = [340, 480, 768, 1080],
  quality = 70,
  loading = 'lazy',
  critical = false,
} = Astro.props;
const mobileImage = await getImage({
  src: mobile,
  widths: mobileWidths,
  format: 'webp',
  quality,
});
---

<picture class="block h-full w-full">
  <source
    media="(width < 768px)"
    type="image/webp"
    srcset={mobileImage.srcSet.attribute}
    sizes="100vw"
    width={mobile.width}
    height={mobile.height}
  />
  <Image
    src={desktop}
    alt=""
    widths={[768, 1200, 1600, 2048]}
    sizes="100vw"
    format="webp"
    quality={quality}
    class="h-full w-full object-cover object-center select-none pointer-events-none"
    loading={loading}
    data-loading-critical={critical ? '' : undefined}
    decoding="async"
  />
</picture>
